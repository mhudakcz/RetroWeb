---
import '../styles/global.css';
import '../styles/pohyb.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../lib/i18n';
import { DEFAULT_LOCALE, LOCALES, localizePath } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  accent?: string;
  locale?: Locale;
  /** Má tato stránka i /en/ a /de/ variantu? (kvůli přepínači jazyků) */
  localized?: boolean;
  /** Osobní stránky (účet, seznam) — ať je vyhledávače neindexují. */
  noindex?: boolean;
}
const {
  title,
  description = 'Průvodce světem retro hraní — historie herních platforem, legendární hry a tipy pro handheldy a Batoceru.',
  accent,
  locale = DEFAULT_LOCALE,
  localized = false,
  noindex = false,
} = Astro.props;
const fullTitle = title === 'RetroWeb' ? title : `${title} · RetroWeb`;

// --- SEO: canonical + hreflang alternativy pro jazykové varianty ---
const site = Astro.site ?? new URL('https://retrowebcz.netlify.app');
const pathname = Astro.url.pathname;
const parts = pathname.split('/').filter(Boolean);
const hasLocalePrefix = parts[0] && parts[0] !== DEFAULT_LOCALE && (LOCALES as readonly string[]).includes(parts[0]);
const basePath = '/' + (hasLocalePrefix ? parts.slice(1) : parts).join('/');
const withSlash = (p: string) => (p === '/' ? '/' : p.endsWith('/') ? p : p + '/');
const abs = (p: string) => new URL(withSlash(p), site).href;
const canonical = abs(basePath === '/' ? (hasLocalePrefix ? `/${parts[0]}` : '/') : pathname);
// alternativy jen pro stránky, které mají všechny jazykové verze
const alternates = localized
  ? LOCALES.map((l) => ({ hreflang: l, href: abs(localizePath(l, basePath)) }))
  : [];

const OG_LOCALE: Record<string, string> = { cs: 'cs_CZ', en: 'en_GB', de: 'de_DE', fr: 'fr_FR' };
const ogLocaleAlt = LOCALES.filter((l) => l !== locale);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'RetroWeb',
  url: new URL('/', site).href,
  inLanguage: locale,
  description,
};
---

<!doctype html>
<html lang={locale} style={accent ? `--accent:${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="IDrnXf4SnlflFK5cWHt2-iOCWeffYIzIWS8mrm6m6xk" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {localized && <link rel="alternate" hreflang="x-default" href={abs(localizePath('cs', basePath))} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
        } catch (e) {}
      })();
    </script>
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RetroWeb" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {localized && ogLocaleAlt.map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {
      import.meta.env.PROD && (
        <>
          <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-P1699EJJD9"></script>
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-P1699EJJD9');
          </script>
        </>
      )
    }
  </head>
  <body>
    <!-- Tri barevne skvrny za obsahem. Jsou dekorace, proto aria-hidden. -->
    <div class="pozadi-zar" aria-hidden="true"><span></span><span></span><span></span></div>
    <Header locale={locale} localized={localized} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} localized={localized} />

    <script is:inline>
      /*
       * Najezd obsahu pri rolovani.
       *
       * Trida .najede se prida az tady, v prohlizeci. Kdyby byla primo
       * v HTML, pri vypnutem JavaScriptu by obsah zustal neviditelny —
       * takhle je v nejhorsim pripade proste hned videt.
       */
      (function () {
        var omezit = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (omezit.matches || !('IntersectionObserver' in window)) return;

        // Co se ma objevovat. Nadpisy a odstavce zamerne ne — text, ktery
        // nabehne az pri rolovani, se spatne cte.
        var vyber = '.card, .grid > *, .picks-box, .series-art, .shotbar figure';
        var prvky = [].slice.call(document.querySelectorAll(vyber));
        if (!prvky.length) return;

        prvky.forEach(function (e) { e.classList.add('najede'); });
        [].slice.call(document.querySelectorAll('.grid, .grid-games')).forEach(
          function (m) { m.classList.add('najede-rada'); });

        var hlidac = new IntersectionObserver(function (zaznamy) {
          zaznamy.forEach(function (z) {
            if (!z.isIntersecting) return;
            z.target.classList.add('je-videt');
            hlidac.unobserve(z.target);   // jednou staci, zpet uz se neskryva
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });

        prvky.forEach(function (e) { hlidac.observe(e); });

        // Co je pri nacteni uz na obrazovce, ukazat hned — jinak by prvni
        // obrazovka chvili blikala prazdnotou.
        requestAnimationFrame(function () {
          prvky.forEach(function (e) {
            var r = e.getBoundingClientRect();
            if (r.top < window.innerHeight) e.classList.add('je-videt');
          });
        });
      })();
    </script>
  </body>
</html>
