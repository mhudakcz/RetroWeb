---
import { t, localizePath, navHref, localePrefix, LOCALES, DEFAULT_LOCALE } from '../lib/i18n';
import type { Locale } from '../lib/i18n';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  locale?: Locale;
  localized?: boolean;
}
const { locale = DEFAULT_LOCALE, localized = false } = Astro.props;

const path = Astro.url.pathname;
const stripLocale = (p: string): string => {
  const parts = p.split('/').filter(Boolean);
  if (parts[0] && (LOCALES as readonly string[]).includes(parts[0]) && parts[0] !== DEFAULT_LOCALE) parts.shift();
  return '/' + parts.join('/');
};
const basePath = stripLocale(path);
const isActive = (base: string) => (base === '/' ? basePath === '/' : basePath.startsWith(base));

// Magazin zatim existuje jen v cestine, takze se do cizojazycne navigace nedava —
// odkaz by vedl na stranku, ktera se v te mutaci nestavi.
const NAV: [string, string][] = [
  ['/', 'nav.home'],
  ['/platformy', 'nav.platforms'],
  ['/hry', 'nav.games'],
  ['/serie', 'nav.series'],
  ['/studia', 'nav.studios'],
  ['/hardware', 'nav.hardware'],
  ...(locale === DEFAULT_LOCALE ? ([['/magazin', 'nav.magazine']] as [string, string][]) : []),
  ['/o-projektu', 'nav.about'],
];
---

<header class="site-header">
  <div class="container bar">
    <a href={localizePath(locale, '/')} class="logo" aria-label="RetroWeb">
      <svg class="logo-mark" viewBox="0 0 32 32" width="38" height="38" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="#141520" />
        <rect x="0.6" y="0.6" width="30.8" height="30.8" rx="7.4" fill="none" stroke="#ff3e7f" stroke-opacity="0.35" />
        <g fill="#ff3e7f">
          <rect x="9" y="8" width="2" height="2" /><rect x="21" y="8" width="2" height="2" />
          <rect x="11" y="10" width="2" height="2" /><rect x="19" y="10" width="2" height="2" />
          <rect x="9" y="12" width="14" height="2" />
          <rect x="7" y="14" width="4" height="2" /><rect x="13" y="14" width="6" height="2" /><rect x="21" y="14" width="4" height="2" />
          <rect x="5" y="16" width="22" height="2" />
          <rect x="5" y="18" width="2" height="2" /><rect x="9" y="18" width="14" height="2" /><rect x="25" y="18" width="2" height="2" />
          <rect x="5" y="20" width="2" height="2" /><rect x="9" y="20" width="2" height="2" /><rect x="21" y="20" width="2" height="2" /><rect x="25" y="20" width="2" height="2" />
          <rect x="11" y="22" width="4" height="2" /><rect x="17" y="22" width="4" height="2" />
        </g>
      </svg>
      <span class="logo-text">Retro<span class="accent">Web</span></span>
    </a>
    <nav id="nav" class="nav" aria-label="RetroWeb">
      {NAV.map(([href, key]) => (
        <a href={navHref(locale, href)} class:list={['nav-link', { active: isActive(href) }]}>{t(locale, key)}</a>
      ))}
      <a id="nav-ucet" href={navHref(locale, '/prihlaseni')} class="nav-link nav-ucet">
        <span aria-hidden="true">☆</span> <span class="nav-ucet-text">{t(locale, 'nav.ucet')}</span>
      </a>
      <button id="theme-nav" class="nav-link theme-nav" type="button">
        <span class="t-dark">{t(locale, 'theme.dark')}</span><span class="t-light">{t(locale, 'theme.light')}</span>
      </button>
    </nav>
    <div class="search" data-prefix={localePrefix(locale)}>
      <input id="site-search" type="search" autocomplete="off" spellcheck="false"
             placeholder={t(locale, 'search.placeholder')} aria-label={t(locale, 'search.label')}
             role="combobox" aria-expanded="false" aria-controls="search-results" />
      <div id="search-results" class="search-results" role="listbox" hidden
           data-empty={t(locale, 'search.empty')}
           data-kind-g={t(locale, 'search.kind.g')} data-kind-p={t(locale, 'search.kind.p')}
           data-kind-r={t(locale, 'search.kind.r')} data-kind-d={t(locale, 'search.kind.d')}></div>
    </div>
    <LangSwitcher locale={locale} localized={localized} drop="down" />
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label={t(locale, 'theme.toggle')} title={t(locale, 'theme.toggle')}>
      <span class="t-dark">🌙</span><span class="t-light">☀️</span>
    </button>
    <button id="nav-toggle" class="nav-toggle" type="button" aria-label={t(locale, 'nav.openMenu')} aria-expanded="false" aria-controls="nav">
      <span class="bars" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  import { prihlasenyEmail } from '../lib/ucet';

  const odkaz = document.getElementById('nav-ucet') as HTMLAnchorElement | null;
  if (odkaz) {
    const predpona = odkaz.getAttribute('href')!.replace(/\/prihlaseni$/, '');
    const prekresli = () => {
      const prihlasen = !!prihlasenyEmail();
      odkaz.href = `${predpona}/${prihlasen ? 'muj-seznam' : 'prihlaseni'}`;
      odkaz.classList.toggle('je-prihlasen', prihlasen);
    };
    prekresli();
    document.addEventListener('retroweb:ucet', prekresli);
  }
</script>

<script is:inline>
  (function () {
    var input = document.getElementById('site-search');
    var box = document.getElementById('search-results');
    if (!input || !box) return;
    var wrap = input.parentElement;
    var prefix = wrap.getAttribute('data-prefix') || '';
    var PATH = { g: '/hry/', p: '/platformy/', r: '/serie/', d: '/studia/' };
    var KIND = {
      g: box.getAttribute('data-kind-g'), p: box.getAttribute('data-kind-p'),
      r: box.getAttribute('data-kind-r'), d: box.getAttribute('data-kind-d'),
    };
    var index = null, loading = false, cursor = -1, rows = [];

    // Bez diakritiky a interpunkce — musi odpovidat fold() v search.json.ts
    function fold(s) {
      return s.normalize('NFKD').replace(/[\u0300-\u036f]/g, '')
        .toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
    }

    function load() {
      if (index || loading) return Promise.resolve();
      loading = true;
      return fetch(prefix + '/search.json')
        .then(function (r) { return r.json(); })
        .then(function (d) { index = d; loading = false; })
        .catch(function () { loading = false; });
    }

    function search(q) {
      var f = fold(q);
      if (!f || !index) return [];
      var starts = [], has = [];
      for (var i = 0; i < index.length; i++) {
        var r = index[i];
        var at = r.f.indexOf(f);
        if (at === 0) starts.push(r);
        else if (at > 0) has.push(r);
      }
      // typy krome her jdou napred — je jich malo a hleda se na ne cileneji
      var out = starts.concat(has);
      out.sort(function (a, b) {
        var ra = a.t === 'g' ? 1 : 0, rb = b.t === 'g' ? 1 : 0;
        return ra - rb || a.n.length - b.n.length;
      });
      return out.slice(0, 12);
    }

    function render(list) {
      rows = list;
      cursor = -1;
      if (!list.length) {
        box.innerHTML = '<p class="sr-empty">' + box.getAttribute('data-empty') + '</p>';
        box.hidden = false;
        input.setAttribute('aria-expanded', 'true');
        return;
      }
      var html = '';
      for (var i = 0; i < list.length; i++) {
        var r = list[i];
        var url = prefix + PATH[r.t] + r.s;
        var meta = r.t === 'g' && r.x ? r.x : KIND[r.t];
        html += '<a class="sr-item" role="option" href="' + url + '">' +
                '<span class="sr-name"></span><span class="sr-meta"></span></a>';
      }
      box.innerHTML = html;
      var items = box.querySelectorAll('.sr-item');
      for (var j = 0; j < items.length; j++) {
        items[j].querySelector('.sr-name').textContent = list[j].n;
        items[j].querySelector('.sr-meta').textContent =
          list[j].t === 'g' && list[j].x ? list[j].x : KIND[list[j].t];
      }
      box.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    }

    function close() {
      box.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      cursor = -1;
    }

    function move(d) {
      var items = box.querySelectorAll('.sr-item');
      if (!items.length) return;
      if (cursor >= 0) items[cursor].classList.remove('on');
      cursor = (cursor + d + items.length) % items.length;
      items[cursor].classList.add('on');
      items[cursor].scrollIntoView({ block: 'nearest' });
    }

    var timer;
    input.addEventListener('input', function () {
      var q = input.value.trim();
      clearTimeout(timer);
      if (q.length < 2) { close(); return; }
      timer = setTimeout(function () {
        load().then(function () { render(search(q)); });
      }, 120);
    });
    input.addEventListener('focus', load);
    input.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
      else if (e.key === 'Escape') { close(); input.blur(); }
      else if (e.key === 'Enter') {
        var items = box.querySelectorAll('.sr-item');
        if (cursor >= 0 && items[cursor]) { e.preventDefault(); items[cursor].click(); }
      }
    });
    document.addEventListener('click', function (e) {
      if (!wrap.contains(e.target)) close();
    });
  })();
</script>

<script is:inline>
  (function () {
    function toggleTheme() {
      var light = document.documentElement.getAttribute('data-theme') === 'light';
      if (light) {
        document.documentElement.removeAttribute('data-theme');
        try { localStorage.setItem('theme', 'dark'); } catch (e) {}
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
        try { localStorage.setItem('theme', 'light'); } catch (e) {}
      }
    }
    var btn = document.getElementById('theme-toggle');
    if (btn) btn.addEventListener('click', toggleTheme);
    var btnNav = document.getElementById('theme-nav');
    if (btnNav) btnNav.addEventListener('click', toggleTheme);

    var navBtn = document.getElementById('nav-toggle');
    var nav = document.getElementById('nav');
    if (navBtn && nav) {
      var close = function () {
        nav.classList.remove('open');
        navBtn.setAttribute('aria-expanded', 'false');
        navBtn.setAttribute('aria-label', 'Otevřít menu');
      };
      navBtn.addEventListener('click', function () {
        var open = nav.classList.toggle('open');
        navBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        navBtn.setAttribute('aria-label', open ? 'Zavřít menu' : 'Otevřít menu');
      });
      // klik mimo / na odkaz menu zavře
      nav.addEventListener('click', function (e) {
        if (e.target && e.target.closest && e.target.closest('a')) close();
      });
      document.addEventListener('click', function (e) {
        if (nav.classList.contains('open') && !nav.contains(e.target) && e.target !== navBtn && !navBtn.contains(e.target)) close();
      });
    }
  })();
</script>

<style>
  .nav-ucet.je-prihlasen { color: #ffcf4d; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 12, 17, 0.78);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-soft);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    gap: 16px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    font-weight: 800;
    font-size: 1.18rem;
  }
  .logo-mark {
    display: block;
    width: 38px;
    height: 38px;
    border-radius: 9px;
    box-shadow: 0 6px 18px -7px var(--accent);
    transition: transform 0.15s ease;
  }
  .logo:hover .logo-mark {
    transform: translateY(-1px) rotate(-3deg);
  }
  .logo .accent {
    color: var(--accent);
  }
  .nav {
    display: flex;
    gap: 4px;
    flex-wrap: nowrap;
  }
  .nav-link {
    padding: 0.5em 0.72em;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.92rem;
    white-space: nowrap;
    color: var(--muted);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav-link:hover {
    color: var(--text);
    background: var(--surface);
  }
  .nav-link.active {
    color: var(--text);
    background: var(--surface-2);
  }
  .logo {
    margin-right: auto;
  }
  .theme-toggle {
    flex: none;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    font-size: 1.02rem;
    line-height: 1;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .theme-toggle:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .theme-toggle .t-light {
    display: none;
  }
  :root[data-theme='light'] .theme-toggle .t-dark {
    display: none;
  }
  :root[data-theme='light'] .theme-toggle .t-light {
    display: inline;
  }
  :root[data-theme='light'] .site-header {
    background: rgba(255, 255, 255, 0.82);
  }

  /* přepínač jazyka v liště (desktop) */
  .lang-switch {
    flex: none;
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .lang-flag {
    font-size: 1rem;
    line-height: 1;
    padding: 4px 5px;
    border-radius: 7px;
    opacity: 0.45;
    filter: grayscale(0.4);
    transition: opacity 0.15s ease, background 0.15s ease;
  }
  .lang-flag:hover { opacity: 0.9; }
  .lang-flag.on {
    opacity: 1;
    filter: none;
    background: var(--surface-2);
  }
  /* přepínač jazyka v mobilním menu (skrytý na desktopu) */
  .lang-nav { display: none; }

  /* přepínač režimu uvnitř mobilního menu (skrytý na desktopu) */
  .theme-nav {
    display: none;
    background: transparent;
    border: none;
    cursor: pointer;
    font: inherit;
    text-align: left;
  }
  .theme-nav .t-light {
    display: none;
  }
  :root[data-theme='light'] .theme-nav .t-dark {
    display: none;
  }
  :root[data-theme='light'] .theme-nav .t-light {
    display: inline;
  }

  /* hamburger – skrytý na desktopu */
  .nav-toggle {
    display: none;
    flex: none;
    width: 38px;
    height: 38px;
    place-items: center;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--surface);
    cursor: pointer;
  }
  .nav-toggle .bars,
  .nav-toggle .bars::before,
  .nav-toggle .bars::after {
    content: '';
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .nav-toggle .bars {
    position: relative;
  }
  .nav-toggle .bars::before {
    position: absolute;
    top: -6px;
  }
  .nav-toggle .bars::after {
    position: absolute;
    top: 6px;
  }
  .nav-toggle[aria-expanded='true'] .bars {
    background: transparent;
  }
  .nav-toggle[aria-expanded='true'] .bars::before {
    top: 0;
    transform: rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .bars::after {
    top: 0;
    transform: rotate(-45deg);
  }

  /* Prah pro hamburger vychazi z mereni, ne z odhadu: cela lista (logo 140,
     navigace ~610, hledani 170, prepinac jazyka 115, prepinac rezimu 38 plus
     mezery a odsazeni) potrebuje ~1180 px. Pod tim se navigace driv lamala do
     druheho radku uvnitr listy vysoke 64 px — presne ta "rozbita" hlavicka. */
  @media (max-width: 1200px) {
    .nav-toggle {
      display: grid;
    }
    #theme-toggle {
      display: none;
    }
    .theme-nav {
      display: block;
      margin-top: 6px;
      border-top: 1px solid var(--border-soft);
      padding-top: 12px;
      border-radius: 0;
    }
    .nav {
      position: absolute;
      flex-wrap: wrap;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 2px;
      padding: 10px 16px 16px;
      background: var(--surface);
      border-bottom: 1px solid var(--border-soft);
      box-shadow: var(--shadow);
      display: none;
    }
    .nav.open {
      display: flex;
    }
    .nav-link {
      padding: 0.7em 0.85em;
      font-size: 0.98rem;
      width: 100%;
    }
    .lang-switch {
      display: none;
    }
    .lang-nav {
      display: flex;
      flex-direction: column;
      gap: 2px;
      margin-top: 6px;
      border-top: 1px solid var(--border-soft);
      padding-top: 10px;
    }
    .lang-opt {
      padding: 0.6em 0.85em;
      border-radius: 8px;
      font-weight: 600;
      color: var(--muted);
    }
    .lang-opt.on {
      color: var(--text);
      background: var(--surface-2);
    }
    .lang-opt .flag {
      margin-right: 6px;
    }
  }
  /* Na mobilu zustava jen znacka loga — napis RetroWeb bere 100 px, ktere
     potrebuje vyhledavaci pole. Znacka odkazuje na uvod stejne dobre. */
  @media (max-width: 520px) {
    .logo-text {
      display: none;
    }
  }

</style>
