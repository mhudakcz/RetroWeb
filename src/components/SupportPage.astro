---
import { KOFI_URL } from '../lib/site';
import { localizePath, DEFAULT_LOCALE } from '../lib/i18n';
import type { Locale } from '../lib/i18n';
const { locale = DEFAULT_LOCALE } = Astro.props as { locale?: Locale };
const lp = (p: string) => localizePath(locale, p);

const T = {
  cs: {
    eyebrow: 'Děkuju za přízeň',
    h1: 'Podpořit RetroWeb',
    lead: 'RetroWeb dělám ve volném čase z lásky k retro hraní — je a zůstane zdarma a bez otravných reklam. Pokud ti web pomohl nebo tě baví, můžeš přihodit na kafe. Každý příspěvek jde na provoz (doména, hosting) a čas na další články, obrázky a překlady.',
    btn: '☕ Podpořit na Ko-fi',
    note: 'Otevře se Ko-fi v novém okně. Zvládneš to i jednorázově, bez registrace.',
    waysTitle: 'Jak ještě můžeš pomoct (zdarma)',
    ways: [
      '<strong>Sdílej</strong> web s kamarády, co taky vyrůstali u konzolí.',
      '<strong>Napiš mi</strong> tip, opravu nebo přání přes <a href="' + lp('/kontakt') + '">kontaktní formulář</a>.',
      '<strong>Navrhni hru nebo platformu</strong>, která tu chybí — u každé platformy je tlačítko „Navrhnout hru".',
    ],
  },
  en: {
    eyebrow: 'Thanks for your support',
    h1: 'Support RetroWeb',
    lead: 'I build RetroWeb in my free time out of love for retro gaming — it is and will stay free, with no annoying ads. If the site helped you or you enjoy it, you can buy me a coffee. Every contribution goes toward running costs (domain, hosting) and time for more articles, images and translations.',
    btn: '☕ Support on Ko-fi',
    note: 'Ko-fi opens in a new tab. A one-off tip works too, no signup needed.',
    waysTitle: 'Other ways to help (free)',
    ways: [
      '<strong>Share</strong> the site with friends who also grew up with consoles.',
      '<strong>Write to me</strong> with a tip, fix or wish via the <a href="' + lp('/kontakt') + '">contact form</a>.',
      '<strong>Suggest a game or platform</strong> that’s missing — every platform has a “Suggest a game” button.',
    ],
  },
  de: {
    eyebrow: 'Danke für deine Unterstützung',
    h1: 'RetroWeb unterstützen',
    lead: 'RetroWeb entsteht in meiner Freizeit aus Liebe zum Retro-Gaming — es ist und bleibt kostenlos, ohne nervige Werbung. Wenn dir die Seite geholfen hat oder Spaß macht, kannst du mir einen Kaffee spendieren. Jeder Beitrag fließt in den Betrieb (Domain, Hosting) und in Zeit für weitere Artikel, Bilder und Übersetzungen.',
    btn: '☕ Auf Ko-fi unterstützen',
    note: 'Ko-fi öffnet in einem neuen Tab. Auch einmalig möglich, ohne Registrierung.',
    waysTitle: 'Wie du sonst helfen kannst (gratis)',
    ways: [
      '<strong>Teile</strong> die Seite mit Freunden, die auch mit Konsolen aufgewachsen sind.',
      '<strong>Schreib mir</strong> einen Tipp, eine Korrektur oder einen Wunsch über das <a href="' + lp('/kontakt') + '">Kontaktformular</a>.',
      '<strong>Schlage ein Spiel oder eine Plattform vor</strong>, das/die fehlt — bei jeder Plattform gibt es einen „Spiel vorschlagen"-Button.',
    ],
  },
  fr: {
    eyebrow: 'Merci pour ton soutien',
    h1: 'Soutenir RetroWeb',
    lead: "Je développe RetroWeb sur mon temps libre, par amour du jeu rétro — il est et restera gratuit, sans publicités agaçantes. Si le site t’a aidé ou te plaît, tu peux m’offrir un café. Chaque contribution sert aux frais de fonctionnement (domaine, hébergement) et au temps consacré à plus d’articles, d’images et de traductions.",
    btn: '☕ Soutenir sur Ko-fi',
    note: 'Ko-fi s’ouvre dans un nouvel onglet. Un don ponctuel fonctionne aussi, sans inscription.',
    waysTitle: 'Autres façons d’aider (gratuit)',
    ways: [
      '<strong>Partage</strong> le site avec des amis qui ont aussi grandi avec les consoles.',
      '<strong>Écris-moi</strong> un conseil, une correction ou un souhait via le <a href="' + lp('/kontakt') + '">formulaire de contact</a>.',
      '<strong>Propose un jeu ou une plateforme</strong> qui manque — chaque plateforme a un bouton « Proposer un jeu ».',
    ],
  },
}[locale];
---

<section class="container narrow">
  <p class="eyebrow">{T.eyebrow}</p>
  <h1>{T.h1}</h1>
  <p class="lead muted">{T.lead}</p>

  <div class="cta">
    <a class="kofi" href={KOFI_URL} target="_blank" rel="noopener">{T.btn}</a>
    <p class="muted small">{T.note}</p>
  </div>

  <div class="ways">
    <h2>{T.waysTitle}</h2>
    <ul>
      {T.ways.map((w) => <li set:html={w} />)}
    </ul>
  </div>
</section>

<style>
  .narrow { max-width: 760px; }
  .eyebrow {
    font-family: var(--font-pixel);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: color-mix(in srgb, var(--accent) 80%, var(--text));
    padding-top: 40px;
  }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin-block: 8px 14px; }
  .lead { font-size: 1.08rem; line-height: 1.7; }
  .cta {
    margin: 32px 0;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    text-align: center;
  }
  .kofi {
    display: inline-block;
    font-weight: 800;
    font-size: 1.05rem;
    padding: 0.8em 1.6em;
    border-radius: 999px;
    color: #1a0710;
    background: linear-gradient(135deg, var(--accent), #ff8fb3);
    box-shadow: 0 8px 22px -8px var(--accent);
    transition: transform 0.15s ease;
  }
  .kofi:hover { transform: translateY(-2px); }
  .cta .small { margin-top: 12px; }
  .ways { margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--border-soft); }
  .ways h2 { font-size: 1.3rem; margin-bottom: 14px; }
  .ways li { margin-bottom: 10px; }
  .ways a { color: var(--accent); }
</style>
