---
import { stats } from '../lib/data';
import { t, navHref, DEFAULT_LOCALE } from '../lib/i18n';
import type { Locale } from '../lib/i18n';
import LangSwitcher from './LangSwitcher.astro';
const { locale = DEFAULT_LOCALE, localized = false } = Astro.props as { locale?: Locale; localized?: boolean };
const lp = (p: string) => navHref(locale, p);
---

<footer class="site-footer">
  <div class="container">
    <div class="cols">
      <div>
        <div class="logo pixel">RetroWeb</div>
        <p class="muted small">{t(locale, 'footer.tagline')}</p>
      </div>
      <div>
        <h4>{t(locale, 'footer.content')}</h4>
        <ul class="links">
          <li><a href={lp('/platformy')}>{t(locale, 'nav.platforms')} ({stats.platforms})</a></li>
          <li><a href={lp('/hry')}>{t(locale, 'nav.games')} ({stats.games})</a></li>
          <li><a href={lp('/hardware')}>{t(locale, 'footer.hardwareLink')}</a></li>
          <li><a href={lp('/o-projektu')}>{t(locale, 'footer.aboutLink')}</a></li>
          <li><a href={lp('/zmeny')}>{t(locale, 'footer.changelog')}</a></li>
        </ul>
      </div>
      <div>
        <h4>{t(locale, 'footer.community')}</h4>
        <ul class="links">
          <li><a href={lp('/kontakt')}>{t(locale, 'nav.contact')}</a></li>
          <li><a href={lp('/podporit')}>{t(locale, 'nav.support')}</a></li>
        </ul>
        <div class="foot-lang">
          <span class="muted small">{t(locale, 'nav.language')}</span>
          <LangSwitcher locale={locale} localized={localized} drop="up" />
        </div>
        <p class="muted small legal">{t(locale, 'footer.legal')}</p>
      </div>
    </div>
    <div class="base">
      <span class="muted small">© {new Date().getFullYear()} RetroWeb · {t(locale, 'footer.built')}</span>
      <span class="muted small">{t(locale, 'footer.data')}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 64px;
    border-top: 1px solid var(--border-soft);
    background: var(--bg-2);
    padding-block: 44px 28px;
  }
  .cols {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.2fr;
    gap: 32px;
  }
  .logo {
    font-size: 0.9rem;
    color: var(--accent);
    margin-bottom: 12px;
  }
  h4 {
    font-size: 0.95rem;
    margin-bottom: 12px;
  }
  .small {
    font-size: 0.86rem;
  }
  .links li + li {
    margin-top: 7px;
  }
  .links a:hover {
    color: var(--accent);
  }
  .legal {
    margin-top: 14px;
  }
  .foot-lang {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
  }
  .base {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--border-soft);
  }
  @media (max-width: 720px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
