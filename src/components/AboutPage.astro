---
import { stats } from '../lib/data';
import { DEFAULT_LOCALE, localizePath } from '../lib/i18n';
import type { Locale } from '../lib/i18n';
const { locale = DEFAULT_LOCALE } = Astro.props as { locale?: Locale };

const T = {
  cs: {
    eyebrow: 'O projektu', h1: 'Co je RetroWeb',
    intro: `<strong>RetroWeb</strong> je průvodce světem retro hraní: historie herních platforem, jejich legendární i méně známé hry a kontext, proč zrovna ony stojí za zahrání. Vznikl jako osobní projekt kolem retro handheldů <strong>Anbernic RG35XX&nbsp;Pro</strong> a <strong>R36S</strong> a systému <strong>Batocera</strong> běžícího na starším PC.`,
    whatTitle: 'Co tu najdeš',
    bullets: [
      `<strong>${stats.platforms} platforem</strong> — od Atari 2600 (1977) po dnešní fantasy konzole PICO-8 a TIC-80, každá s historií a kontextem.`,
      `<strong>${stats.games} her</strong> — kurátorský výběr klasik, skrytých pokladů, logických her i moderních homebrew novinek.`,
      `<strong>${stats.withDetail} detailních komentářů</strong> — u vybraných her se dozvíš žánr, rok, studio a pořádný odstavec faktů.`,
    ],
    forWhoTitle: 'Pro koho to je',
    forWho: `Pro začínajícího i pokročilého retrohráče, který si chce udělat přehled, co na svůj handheld nebo Batoceru pustit jako první — a přitom pochopit, proč jsou tyhle hry a krabičky tak milované.`,
    legalTitle: '⚖️ Hraj legálně',
    legal: `Tento web <strong>nenabízí žádné ROM soubory</strong> ani odkazy na pirátský obsah. Hry sháněj legálně — vytvoř si vlastní dumpy svých kazet a disků, nebo sáhni po <strong>homebrew a freeware</strong> titulech (na webu označené&nbsp;🆓).`,
    changelogTitle: 'Co se na webu mění',
    changelog: `Web průběžně roste — přibývají platformy, hry i překlady. Co konkrétně a kdy přibylo najdeš na stránce <a href="__HREF__">Co je nového</a>.`,
    imgTitle: 'Zdroje obrázků',
    img: `Fotografie konzolí pocházejí z <strong>Wikipedie / Wikimedia Commons</strong> (volné licence). Obaly her jsou z komunitní databáze <strong>libretro-thumbnails</strong> — stejné, jaké používá RetroArch a Batocera — a u novějších platforem ze <strong>Steamu</strong> a <strong>Nintendo eShopu</strong>, protože pro ně libretro obaly nemá; u konzolových exkluzivit, které nevede žádný obchod, z <strong>Wikipedie</strong>. Práva na obaly náleží vydavatelům; zde slouží jen k identifikaci her ve fanouškovském katalogu.`,
  },
  en: {
    eyebrow: 'About', h1: 'What RetroWeb is',
    intro: `<strong>RetroWeb</strong> is a guide to the world of retro gaming: the history of gaming platforms, their legendary and lesser-known games, and the context for why they're worth playing. It started as a personal project around the <strong>Anbernic RG35XX&nbsp;Pro</strong> and <strong>R36S</strong> handhelds and <strong>Batocera</strong> running on an older PC.`,
    whatTitle: `What you'll find here`,
    bullets: [
      `<strong>${stats.platforms} platforms</strong> — from the Atari 2600 (1977) to today's fantasy consoles PICO-8 and TIC-80, each with its history and context.`,
      `<strong>${stats.games} games</strong> — a curated selection of classics, hidden gems, puzzlers and modern homebrew releases.`,
      `<strong>${stats.withDetail} detailed write-ups</strong> — selected games come with genre, year, studio and a solid paragraph of facts.`,
    ],
    forWhoTitle: `Who it's for`,
    forWho: `For beginner and advanced retro gamers alike who want an overview of what to play first on their handheld or Batocera — and to understand why these games and devices are so loved.`,
    legalTitle: '⚖️ Play legally',
    legal: `This site offers <strong>no ROM files</strong> and no links to pirated content. Get games legally — make your own dumps of your cartridges and discs, or reach for <strong>homebrew and freeware</strong> titles (marked&nbsp;🆓 on the site).`,
    changelogTitle: 'What keeps changing here',
    changelog: `The site keeps growing — platforms, games and translations get added over time. For what arrived and when, see <a href="__HREF__">What's new</a>.`,
    imgTitle: 'Image sources',
    img: `Console photos come from <strong>Wikipedia / Wikimedia Commons</strong> (free licences). Game covers are from the community database <strong>libretro-thumbnails</strong> — the same ones RetroArch and Batocera use — and, for newer platforms, from <strong>Steam</strong> and the <strong>Nintendo eShop</strong>, since libretro carries no covers for those; console exclusives that no store carries come from <strong>Wikipedia</strong>. Cover rights belong to their publishers; here they only serve to identify games in a fan catalogue.`,
  },
  de: {
    eyebrow: 'Über', h1: 'Was RetroWeb ist',
    intro: `<strong>RetroWeb</strong> ist ein Wegweiser durch die Welt des Retro-Gamings: die Geschichte der Spielplattformen, ihre legendären und weniger bekannten Spiele und der Kontext, warum sie das Spielen wert sind. Entstanden als persönliches Projekt rund um die Handhelds <strong>Anbernic RG35XX&nbsp;Pro</strong> und <strong>R36S</strong> sowie <strong>Batocera</strong> auf einem älteren PC.`,
    whatTitle: 'Was du hier findest',
    bullets: [
      `<strong>${stats.platforms} Plattformen</strong> — vom Atari 2600 (1977) bis zu den heutigen Fantasy-Konsolen PICO-8 und TIC-80, jede mit Geschichte und Kontext.`,
      `<strong>${stats.games} Spiele</strong> — eine kuratierte Auswahl an Klassikern, Geheimtipps, Knobelspielen und modernen Homebrew-Neuheiten.`,
      `<strong>${stats.withDetail} ausführliche Texte</strong> — ausgewählte Spiele mit Genre, Jahr, Studio und einem ordentlichen Absatz Fakten.`,
    ],
    forWhoTitle: 'Für wen es ist',
    forWho: `Für Einsteiger und fortgeschrittene Retro-Spieler, die einen Überblick wollen, was sie auf ihrem Handheld oder Batocera zuerst spielen sollten — und verstehen möchten, warum diese Spiele und Geräte so geliebt werden.`,
    legalTitle: '⚖️ Spiele legal',
    legal: `Diese Seite bietet <strong>keine ROM-Dateien</strong> und keine Links zu raubkopierten Inhalten. Beschaffe Spiele legal — erstelle eigene Dumps deiner Module und Discs oder greife zu <strong>Homebrew und Freeware</strong> (auf der Seite mit&nbsp;🆓 markiert).`,
    changelogTitle: 'Was sich hier laufend ändert',
    changelog: `Die Seite wächst laufend — Plattformen, Spiele und Übersetzungen kommen nach und nach dazu. Was wann dazukam, steht unter <a href="__HREF__">Was ist neu</a>.`,
    imgTitle: 'Bildquellen',
    img: `Konsolenfotos stammen von <strong>Wikipedia / Wikimedia Commons</strong> (freie Lizenzen). Spiele-Cover stammen aus der Community-Datenbank <strong>libretro-thumbnails</strong> — dieselben, die RetroArch und Batocera nutzen — und bei neueren Plattformen von <strong>Steam</strong> und dem <strong>Nintendo eShop</strong>, da libretro dafür keine Cover führt; Konsolen-Exklusivtitel, die kein Shop führt, stammen aus der <strong>Wikipedia</strong>. Die Rechte an den Covern liegen bei den Verlagen; hier dienen sie nur der Identifikation der Spiele in einem Fan-Katalog.`,
  },
  fr: {
    eyebrow: 'À propos', h1: 'Ce qu’est RetroWeb',
    intro: `<strong>RetroWeb</strong> est un guide du monde du jeu rétro : l’histoire des plateformes de jeu, leurs jeux légendaires et méconnus, et le contexte qui explique pourquoi ils valent la peine d’être joués. C’est né comme un projet personnel autour des consoles portables <strong>Anbernic RG35XX&nbsp;Pro</strong> et <strong>R36S</strong> et de <strong>Batocera</strong> tournant sur un vieux PC.`,
    whatTitle: 'Ce que tu trouveras ici',
    bullets: [
      `<strong>${stats.platforms} plateformes</strong> — de l’Atari 2600 (1977) aux consoles fantasy actuelles PICO-8 et TIC-80, chacune avec son histoire et son contexte.`,
      `<strong>${stats.games} jeux</strong> — une sélection soignée de classiques, de trésors cachés, de jeux de réflexion et de nouveautés homebrew modernes.`,
      `<strong>${stats.withDetail} commentaires détaillés</strong> — les jeux sélectionnés viennent avec genre, année, studio et un solide paragraphe de faits.`,
    ],
    forWhoTitle: 'Pour qui c’est',
    forWho: `Pour le rétrogamer débutant comme confirmé qui veut un aperçu de ce à quoi jouer en premier sur sa console portable ou Batocera — et comprendre pourquoi ces jeux et ces appareils sont tant aimés.`,
    legalTitle: '⚖️ Joue légalement',
    legal: `Ce site <strong>ne propose aucun fichier ROM</strong> ni lien vers du contenu piraté. Procure-toi les jeux légalement — crée tes propres dumps de tes cartouches et disques, ou tourne-toi vers les titres <strong>homebrew et freeware</strong> (marqués&nbsp;🆓 sur le site).`,
    changelogTitle: 'Ce qui évolue ici',
    changelog: `Le site grandit en continu — plateformes, jeux et traductions s’ajoutent au fil du temps. Pour savoir ce qui est arrivé et quand, voir <a href="__HREF__">Quoi de neuf</a>.`,
    imgTitle: 'Sources des images',
    img: `Les photos de consoles proviennent de <strong>Wikipédia / Wikimedia Commons</strong> (licences libres). Les jaquettes viennent de la base communautaire <strong>libretro-thumbnails</strong> — les mêmes qu’utilisent RetroArch et Batocera — et, pour les plateformes récentes, de <strong>Steam</strong> et du <strong>Nintendo eShop</strong>, faute de jaquettes chez libretro ; les exclusivités console qu’aucune boutique ne propose viennent de <strong>Wikipédia</strong>. Les droits appartiennent aux éditeurs ; ici, elles servent uniquement à identifier les jeux dans un catalogue de fans.`,
  },
}[locale];
---

<article class="container narrow">
  <header class="head">
    <p class="eyebrow">{T.eyebrow}</p>
    <h1>{T.h1}</h1>
  </header>

  <div class="prose">
    <p set:html={T.intro} />
    <h2>{T.whatTitle}</h2>
    <ul class="bullets">{T.bullets.map((b) => <li set:html={b} />)}</ul>
    <h2>{T.forWhoTitle}</h2>
    <p>{T.forWho}</p>
    <div class="callout">
      <h3>{T.legalTitle}</h3>
      <p set:html={T.legal} />
    </div>
    <h2>{T.changelogTitle}</h2>
    <p set:html={T.changelog.replace('__HREF__', localizePath(locale, '/zmeny'))} />
    <h2>{T.imgTitle}</h2>
    <p set:html={T.img} />
  </div>
</article>

<style>
  .narrow { max-width: 760px; }
  .head { padding-block: 48px 8px; }
  .head h1 { font-size: clamp(2rem, 5vw, 3rem); margin-top: 8px; }
  .prose { font-size: 1.06rem; }
  .prose h2 { font-size: 1.45rem; margin-block: 32px 12px; }
  .bullets { display: flex; flex-direction: column; gap: 10px; margin-bottom: 1em; }
  .bullets li { padding-left: 22px; position: relative; color: var(--text); }
  .bullets li::before { content: '▸'; position: absolute; left: 0; color: var(--accent); }
  .bullets :global(strong) { color: var(--text); }
  .callout { background: linear-gradient(135deg, rgba(255, 62, 127, 0.1), rgba(54, 226, 255, 0.06)); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px 22px; margin-block: 28px; }
  .callout h3 { font-size: 1.15rem; margin-bottom: 8px; }
  .callout p { margin: 0; }
</style>
