---
import HardwareArt from './HardwareArt.astro';
import { hardware } from '../data/hardware';
import { hardwareMetaLoc } from '../lib/data';
import { t, localizePath, DEFAULT_LOCALE } from '../lib/i18n';
import type { Locale } from '../lib/i18n';
const { locale = DEFAULT_LOCALE } = Astro.props as { locale?: Locale };
const lp = (p: string) => localizePath(locale, p);
const metaAll = locale === DEFAULT_LOCALE ? {} : hardwareMetaLoc(locale);
const kindOf = (h: any) => metaAll[h.slug]?.kind ?? h.kind;
---

<section class="container head">
  <p class="eyebrow">{t(locale, 'hw.eyebrow')}</p>
  <h1>{t(locale, 'hw.title')}</h1>
  <p class="muted lead">{t(locale, 'hw.lead')}</p>
</section>

<section class="section">
  <div class="container">
    <div class="grid grid-hw">
      {hardware.map((h) => (
        <a class="card hw-card" href={lp(`/hardware/${h.slug}`)} style={`--c1:${h.color}; --c2:${h.color2}`}>
          {h.photo ? (
            <div class={`hw-photo${h.photo.fit === 'contain' ? ' contain' : ''}`}>
              <img src={h.photo.src} alt={h.name} loading="lazy" />
            </div>
          ) : (
            <HardwareArt art={h.art} color={h.color} color2={h.color2} />
          )}
          <div class="hw-body">
            <h2>{h.name}</h2>
            <p class="muted">{kindOf(h)}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .head { padding-block: 48px 8px; }
  .head h1 { font-size: clamp(2rem, 5vw, 3rem); margin-block: 8px 12px; }
  .lead { max-width: 640px; font-size: 1.05rem; }
  .grid-hw { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; }
  .hw-photo { aspect-ratio: 16 / 10; overflow: hidden; background: radial-gradient(120% 120% at 75% 10%, color-mix(in srgb, var(--c1) 30%, transparent), transparent 60%), linear-gradient(160deg, var(--c2), #0b0c11); }
  .hw-photo img { width: 100%; height: 100%; object-fit: contain; padding: 16px; display: block; }
  .hw-card { display: flex; flex-direction: column; }
  .hw-card:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--c1) 55%, var(--border)); box-shadow: var(--shadow); }
  .hw-body { padding: 13px 15px 15px; }
  .hw-body h2 { font-size: 1rem; line-height: 1.25; }
  .hw-body .muted { font-size: 0.82rem; margin-top: 3px; }
</style>
