---
import { localeData, groupByLetter, alphaAnchor } from '../lib/data';
import { t, localizePath, DEFAULT_LOCALE } from '../lib/i18n';
import type { Locale } from '../lib/i18n';
const { locale = DEFAULT_LOCALE } = Astro.props as { locale?: Locale };
const { studios } = localeData(locale);
// pres dve stovky studii v jedne mrizce se neda prochazet
const { letters, groups } = groupByLetter(studios);
---

<section class="container head">
  <p class="eyebrow">{t(locale, 'studios.eyebrow')}</p>
  <h1>{t(locale, 'studios.title')}</h1>
  <p class="muted lead">{t(locale, 'studios.lead')}</p>
</section>

<section class="section">
  <div class="container">
    <nav class="alpha" aria-label={t(locale, 'series.jump')}>
      {letters.map((l) => <a href={`#${alphaAnchor(l)}`}>{l}</a>)}
    </nav>

    {letters.map((letter) => (
    <div class="alpha-group" id={alphaAnchor(letter)}>
    <h2 class="alpha-head">{letter}</h2>
    <div class="grid studio-grid">
      {
        groups.get(letter)!.map((s) => {
          const plats = [...new Set(s.games.map((g) => g.platform.short))].slice(0, 6);
          return (
            <a class="card studio-card" href={localizePath(locale, `/studia/${s.slug}`)}>
              {s.image && (
                <span class="sc-art">
                  <img src={s.image} alt="" loading="lazy" decoding="async" />
                </span>
              )}
              <div class="sc-body">
                <h2>{s.name}</h2>
                <p class="meta muted">{s.gameCount} {t(locale, 'games.count')} · {plats.join(', ')}</p>
              </div>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          );
        })
      }
    </div>
    </div>
    ))}
  </div>
</section>

<style>
  .head { padding-block: 48px 0; }
  .head h1 { font-size: clamp(2rem, 5vw, 3rem); margin-block: 8px 10px; }
  .lead { font-size: 1.05rem; max-width: 640px; }
  .studio-grid { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); margin-top: 16px; }
  /* koláž je 1200x420 — proto jde přes celou šířku karty a text je pod ní */
  .studio-card { display: flex; flex-direction: column; padding: 0; overflow: hidden; }
  .studio-card .sc-art { display: block; aspect-ratio: 1200 / 420; overflow: hidden; }
  .studio-card .sc-art img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .studio-card .sc-body { padding: 14px 16px 4px; }
  .studio-card .arrow { align-self: flex-end; padding: 0 16px 12px; }
  .studio-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
    box-shadow: var(--shadow);
  }
  .sc-body h2 { font-size: 1.1rem; }
  .meta { font-size: 0.84rem; margin-top: 3px; }
  .arrow { color: var(--muted); flex: none; }
  .studio-card:hover .arrow { color: var(--accent); }
</style>
