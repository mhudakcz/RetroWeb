---
import PlatformCard from './PlatformCard.astro';
import GameCard from './GameCard.astro';
import HardwareArt from './HardwareArt.astro';
import { platformsByType, allGames, stats } from '../lib/data';
import { hardware } from '../data/hardware';
import { t, navHref, DEFAULT_LOCALE } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

const { locale = DEFAULT_LOCALE } = Astro.props as { locale?: Locale };
const lp = (p: string) => navHref(locale, p);
const groups = platformsByType();
const featured = allGames.filter((g) => g.flags.includes('mustplay')).slice(0, 6);
---

<section class="hero scanlines hero-wide">
  <div class="container hero-inner">
    <p class="eyebrow">{t(locale, 'home.eyebrow')}</p>
    <h1>
      {t(locale, 'home.h1a')} <span class="grad">{t(locale, 'home.h1b')}</span><br />
      {t(locale, 'home.h1c')}
    </h1>
    <p class="lead muted">{t(locale, 'home.lead')}</p>
    <div class="cta">
      <a class="btn btn-primary" href={lp('/platformy')}>{t(locale, 'home.ctaPlatforms')}</a>
      <a class="btn" href={lp('/hry')}>{t(locale, 'home.ctaGames')}</a>
    </div>
    <ul class="stats">
      <li><span class="num pixel pocitadlo" data-cil={stats.platforms}>0</span><span class="lbl">{t(locale, 'platforms.count')}</span></li>
      <li><span class="num pixel pocitadlo" data-cil={stats.games}>0</span><span class="lbl">{t(locale, 'games.count')}</span></li>
      <li><span class="num pixel pocitadlo" data-cil={stats.gameImages}>0</span><span class="lbl">{t(locale, 'home.images')}</span></li>
    </ul>
  </div>
</section>

<nav class="jump" aria-label={t(locale, 'home.jump')}>
  <span class="fade fade-l" aria-hidden="true"></span>
  <span class="fade fade-r" aria-hidden="true"></span>
  <div class="container jump-inner">
    {groups.map((g) => (
      <a href={`#typ-${g.type}`}>
        {t(locale, `type.${g.type}.label`)} <span class="j-n">{g.items.length}</span>
      </a>
    ))}
  </div>
</nav>

{
  groups.map((group) => (
    <section class="section" id={`typ-${group.type}`}>
      <div class="container">
        <div class="sec-head">
          <div>
            <p class="eyebrow">{t(locale, `type.${group.type}.label`)}</p>
            <h2>{t(locale, `type.${group.type}.tag`)}</h2>
          </div>
          <span class="muted count">{group.items.length} {t(locale, 'platforms.count')}</span>
        </div>
        <div class="grid grid-platforms">
          {group.items.map((p) => <PlatformCard platform={p} locale={locale} />)}
        </div>
      </div>
    </section>
  ))
}

<section class="section hw-sec">
  <div class="container">
    <div class="sec-head">
      <div>
        <p class="eyebrow">{t(locale, 'home.hwEyebrow')}</p>
        <h2>{t(locale, 'home.hwTitle')}</h2>
      </div>
      <a class="muted link" href={lp('/hardware')}>{t(locale, 'home.hwAll')}</a>
    </div>
    <div class="grid grid-hw">
      {hardware.map((h) => (
        <a class="card hw-card" href={lp(`/hardware/${h.slug}`)} style={`--c1:${h.color}; --c2:${h.color2}`}>
          {h.photo ? (
            <div class={`hw-photo${h.photo.fit === 'contain' ? ' contain' : ''}`}>
              <img src={h.photo.src} alt={h.name} loading="lazy" />
            </div>
          ) : (
            <HardwareArt art={h.art} color={h.color} color2={h.color2} />
          )}
          <div class="hw-body">
            <h3>{h.name}</h3>
            <p class="muted">{h.kind}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

{
  featured.length > 0 && (
    <section class="section featured">
      <div class="container">
        <div class="sec-head">
          <div>
            <p class="eyebrow">{t(locale, 'home.featEyebrow')}</p>
            <h2>{t(locale, 'home.featTitle')}</h2>
          </div>
          <a class="muted link" href={lp('/hry')}>{t(locale, 'home.gamesAll')}</a>
        </div>
        <div class="grid grid-games">
          {featured.map((g) => <GameCard game={g} platform={g.platform} showPlatform locale={locale} />)}
        </div>
      </div>
    </section>
  )
}

<!-- Ukazatel polohy pri rolovani. Obsah se doplni v prohlizeci podle sekci,
     ktere na strance opravdu jsou, aby se nemusel udrzovat rucne. -->
<nav class="poloha" id="poloha" aria-label="Poloha na strance" hidden>
  <span class="poloha-procento" id="poloha-procento">0 %</span>
  <span class="poloha-lista" aria-hidden="true"><i id="poloha-vypln"></i></span>
  <ul class="poloha-tecky" id="poloha-tecky"></ul>
</nav>

<script is:inline>
  (function () {
    var nav = document.querySelector('.jump');
    var strip = nav && nav.querySelector('.jump-inner');
    if (!strip) return;

    var levy = nav.querySelector('.fade-l');
    var pravy = nav.querySelector('.fade-r');

    // Viditelnost drzi skript, ne trida v CSS — je to jedina hodnota, o kterou
    // se nikdo jiny nepere, a stin se tak chova stejne v dev i v produkci.
    function stav() {
      var lze = strip.scrollWidth - strip.clientWidth;
      levy.style.opacity = strip.scrollLeft > 4 ? '1' : '0';
      pravy.style.opacity = (lze > 4 && strip.scrollLeft < lze - 4) ? '1' : '0';
    }

    // Kolecko mysi dava jen deltaY; bez tohohle by se pas na desktopu
    // nedal posunout vubec (dotyk a trackpad funguji i bez toho).
    strip.addEventListener('wheel', function (e) {
      if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
      var lze = strip.scrollWidth - strip.clientWidth;
      if (lze <= 0) return;
      var novy = strip.scrollLeft + e.deltaY;
      if (novy < 0 || novy > lze) return;   // na kraji at scrolluje stranka
      e.preventDefault();
      strip.scrollLeft = novy;
    }, { passive: false });

    strip.addEventListener('scroll', stav, { passive: true });
    window.addEventListener('resize', stav);
    stav();
  })();
</script>

<script is:inline>
  /*
   * Pocitadla v hero se rozjedou od nuly.
   *
   * Statisticke cislo, ktere proste stoji, si clovek precte a zapomene;
   * kdyz nabehne, vsimne si ho. Bezi jen jednou a jen kdyz je hero videt,
   * takze to nic nestoji.
   */
  (function () {
    var prvky = [].slice.call(document.querySelectorAll('.pocitadlo'));
    if (!prvky.length) return;

    var omezit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (omezit) {
      prvky.forEach(function (e) { e.textContent = e.getAttribute('data-cil'); });
      return;
    }

    function rozjed(e) {
      var cil = parseInt(e.getAttribute('data-cil'), 10) || 0;
      var zacatek = performance.now();
      var doba = 1100;
      function krok(t) {
        var p = Math.min(1, (t - zacatek) / doba);
        // zpomaleni na konci, at cislo "dosedne" misto aby seklo
        var e2 = 1 - Math.pow(1 - p, 3);
        e.textContent = Math.round(cil * e2).toLocaleString('cs-CZ');
        if (p < 1) requestAnimationFrame(krok);
      }
      requestAnimationFrame(krok);
    }

    if (!('IntersectionObserver' in window)) {
      prvky.forEach(rozjed);
      return;
    }
    var hlidac = new IntersectionObserver(function (zaznamy) {
      zaznamy.forEach(function (z) {
        if (!z.isIntersecting) return;
        rozjed(z.target);
        hlidac.unobserve(z.target);
      });
    }, { threshold: 0.4 });
    prvky.forEach(function (e) { hlidac.observe(e); });
  })();
</script>

<script is:inline>
  /*
   * Ukazatel polohy pri rolovani.
   *
   * Seznam sekci se sestavuje z toho, co na strance opravdu je — kdyz nekdo
   * pridá nebo ubere skupinu platforem, lista se prizpusobi sama. Nazev se
   * bere z nadpisu sekce, a kdyz zadny nema, z jeji nadlinky.
   */
  (function () {
    var lista = document.getElementById('poloha');
    var tecky = document.getElementById('poloha-tecky');
    var vypln = document.getElementById('poloha-vypln');
    var procento = document.getElementById('poloha-procento');
    if (!lista || !tecky || !vypln || !procento) return;

    // Na mobilu se lista skryva v CSS; nema smysl pro ni pocitat.
    if (!window.matchMedia('(min-width: 1101px)').matches) return;

    var hero = document.querySelector('.hero');
    var sekce = [].slice.call(document.querySelectorAll('section.section'));
    var cile = (hero ? [{ el: hero, nazev: 'Nahoru' }] : []).concat(
      sekce.map(function (s) {
        // Nadlinka ma kratke oznaceni ("HERNÍ KONZOLE"), nadpis je dlouhy
        // podtitulek — proto se bere nejdriv nadlinka.
        var e = s.querySelector('.eyebrow');
        var h = s.querySelector('h2');
        var nazev = (e && e.textContent.trim()) || (h && h.textContent.trim()) || '';
        nazev = nazev.split(/[.,—]/)[0].trim().slice(0, 30);
        return { el: s, nazev: nazev };
      }).filter(function (x) { return x.nazev; })
    );
    if (cile.length < 3) return;   // na kratke strance nema smysl

    cile.forEach(function (c, i) {
      var li = document.createElement('li');
      var b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('data-nazev', c.nazev);
      b.setAttribute('aria-label', c.nazev);
      b.addEventListener('click', function () {
        c.el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      li.appendChild(b);
      tecky.appendChild(li);
      c.tlacitko = b;
      if (i === 0) b.setAttribute('aria-current', 'true');
    });

    lista.hidden = false;

    var ceka = false;
    function prepocitat() {
      ceka = false;
      var vyska = document.documentElement.scrollHeight - window.innerHeight;
      var p = vyska > 0 ? Math.min(1, Math.max(0, window.scrollY / vyska)) : 0;
      vypln.style.height = (p * 100) + '%';
      procento.textContent = Math.round(p * 100) + ' %';

      // Aktivni je posledni sekce, jejiz zacatek je nad tretinou obrazovky.
      var hranice = window.innerHeight * 0.34;
      var aktivni = 0;
      for (var i = 0; i < cile.length; i++) {
        if (cile[i].el.getBoundingClientRect().top <= hranice) aktivni = i;
      }
      cile.forEach(function (c, i) {
        if (i === aktivni) c.tlacitko.setAttribute('aria-current', 'true');
        else c.tlacitko.removeAttribute('aria-current');
      });
    }

    // Pri rolovani se neprepocitava na kazdy pixel, ale jednou za snimek.
    window.addEventListener('scroll', function () {
      if (ceka) return;
      ceka = true;
      requestAnimationFrame(prepocitat);
    }, { passive: true });
    window.addEventListener('resize', prepocitat, { passive: true });
    prepocitat();
  })();
</script>

<style>
  .hero {
    position: relative;  /* kotva pro kolaz v ::before */
    overflow: hidden;
    border-bottom: 1px solid var(--border-soft);
    background:
      radial-gradient(800px 380px at 18% -10%, rgba(255, 62, 127, 0.16), transparent 60%),
      radial-gradient(700px 360px at 92% 0%, rgba(54, 226, 255, 0.12), transparent 55%);
  }
  .hero-inner { padding-block: 72px 60px; max-width: 760px; }
  h1 { font-size: clamp(2.3rem, 6vw, 3.7rem); margin-block: 14px 18px; }
  .grad {
    background: linear-gradient(110deg, var(--accent), var(--accent-3) 60%, var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead { font-size: 1.12rem; max-width: 620px; }
  .lead strong { color: var(--text); }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
  .stats { display: flex; gap: 38px; margin-top: 44px; flex-wrap: wrap; }
  .stats li { display: flex; flex-direction: column; gap: 4px; }
  .num { font-size: 1.5rem; color: var(--accent-3); }
  .lbl { font-size: 0.82rem; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; }
  .sec-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
  }
  .sec-head h2 { font-size: clamp(1.3rem, 3vw, 1.7rem); margin-top: 4px; }
  .sec-head .count { font-size: 0.85rem; white-space: nowrap; }
  .link:hover { color: var(--accent); }
  .featured { background: var(--bg-2); border-block: 1px solid var(--border-soft); }
  .grid-hw { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; }
  .hw-photo {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background:
      radial-gradient(120% 120% at 75% 10%, color-mix(in srgb, var(--c1) 30%, transparent), transparent 60%),
      linear-gradient(160deg, var(--c2), #0b0c11);
  }
  .hw-photo img { width: 100%; height: 100%; object-fit: contain; padding: 16px; display: block; }
  .hw-card { display: flex; flex-direction: column; }
  .hw-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--c1) 55%, var(--border));
    box-shadow: var(--shadow);
  }
  .hw-body { padding: 13px 15px 15px; }
  .hw-body h3 { font-size: 1rem; line-height: 1.25; }
  .hw-body .muted { font-size: 0.82rem; margin-top: 3px; }
  .section + .section { padding-top: 8px; }

  /* ====================== oziveni homepage ======================
     Prvni verze efektu byla tak jemna, ze si jich nikdo nevsiml.
     Tady uz jde o veci, ktere jsou videt na prvni pohled. */

  /* Stena obalu za textem velmi pomalu putuje do strany. Rozsah je maly
     (2 %), takze to nerusi cteni, ale hero prestane byt obrazkem a zacne
     pusobit jako zaber. */
  .hero-wide {
    background-size:
      auto, auto,
      112% auto,
      auto;
    /* animace (hero-put + crt-mihotani) je nize v bloku CRT obrazovky */
  }
  @keyframes hero-put {
    from { background-position: center, center, 42% center, center; }
    to   { background-position: center, center, 58% center, center; }
  }

  /* Zari za nadpisem, ktere pomalu dycha. Dava hero stred, ktery mu chybel. */
  .hero-inner::before {
    content: '';
    position: absolute;
    left: -8%;
    top: 4%;
    width: 60%;
    height: 70%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(circle,
      color-mix(in srgb, var(--accent) 34%, transparent) 0%,
      transparent 68%);
    filter: blur(52px);
    animation: hero-dech 7s ease-in-out infinite;
  }
  @keyframes hero-dech {
    0%, 100% { opacity: 0.55; transform: scale(1); }
    50%      { opacity: 0.95; transform: scale(1.12); }
  }

  /* "INSERT COIN - PRESS START" blika jako na automatu, ktery ceka na hrace.
     Nezhasina uplne, aby to po case neotravovalo. */
  .eyebrow {
    animation: automat 2.4s steps(1, end) infinite;
    text-shadow: 0 0 12px color-mix(in srgb, var(--accent) 60%, transparent);
  }
  @keyframes automat {
    0%, 62%  { opacity: 1; }
    70%, 88% { opacity: 0.28; }
    96%, 100% { opacity: 1; }
  }

  /* Cisla se rozjizdi od nuly (viz skript nize) a sviti barvou znacky. */
  .num {
    text-shadow: 0 0 18px color-mix(in srgb, var(--accent-3) 55%, transparent);
    font-variant-numeric: tabular-nums;
  }

  /* Vyrazna scanline pres hero. Predchozi byla na hranici viditelnosti;
     tahle uz je znat, ale porad se pres ni cte. */
  .hero.scanlines::after {
    background-image: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.30) 0px,
      rgba(0, 0, 0, 0.30) 1px,
      transparent 2px,
      transparent 4px
    );
    opacity: 0.55;
    animation: scan-hero 6s linear infinite;
  }
  @keyframes scan-hero {
    from { background-position-y: 0; }
    to   { background-position-y: 4px; }
  }

  /* Svetly pruh, ktery jednou za cas projede hero shora dolu — jako kdyz se
     na CRT rozjede obraz. */
  .hero::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 28%;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg,
      transparent,
      color-mix(in srgb, var(--accent-2) 12%, transparent),
      transparent);
    animation: crt-pruh 9s ease-in-out infinite;
  }
  @keyframes crt-pruh {
    0%, 58%   { top: -30%; opacity: 0; }
    62%       { opacity: 0.9; }
    92%, 100% { top: 105%; opacity: 0; }
  }

  /* Tlacitka hero: hlavni pulzuje kruhem, aby bylo jasne, kam kliknout. */
  .cta .btn-primary {
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent);
    animation: puls 3.2s ease-out infinite;
  }
  @keyframes puls {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 50%, transparent); }
    70%  { box-shadow: 0 0 0 16px color-mix(in srgb, var(--accent) 0%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 0%, transparent); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-wide,
    .hero-inner::before,
    .eyebrow,
    .hero.scanlines::after,
    .hero::before,
    .cta .btn-primary {
      animation: none !important;
    }
    .hero::before { display: none; }
  }

  /* ===================== CRT obrazovka =====================
     Hero se chova jako televizni tubus: ma vinetaci, naznak vyklenuti,
     fosforovou zar a obcas se mu rozjede stopa. */

  /* Vinetace a vyklenuti skla. Kresli se pres obsah, ale je to jen stin,
     takze text pod nim zustava citelny. */
  .hero-inner::after {
    content: '';
    position: absolute;
    inset: -40px -60px;
    z-index: 3;
    pointer-events: none;
    background:
      radial-gradient(120% 100% at 50% 50%,
        transparent 52%,
        rgba(0, 0, 0, 0.28) 84%,
        rgba(0, 0, 0, 0.52) 100%);
  }

  /* Fosforova zar nadpisu. Skutecny luminofor nesviti ostre — okolo pismen
     je vzdycky trochu rozliteho svetla. */
  .hero h1 {
    text-shadow:
      0 0 26px color-mix(in srgb, var(--accent) 32%, transparent),
      0 0 60px color-mix(in srgb, var(--accent-2) 18%, transparent);
  }

  /* Zapnuti obrazovky: pri nacteni se z uzkeho pruhu rozjede cely obraz.
     Bezi jednou, 0.9 s, a pak uz na strance neni. */
  @keyframes crt-zapnuti {
    0%   { clip-path: inset(49.6% 0 49.6% 0); filter: brightness(3.2) saturate(0.2); }
    38%  { clip-path: inset(46% 0 46% 0);     filter: brightness(2.2) saturate(0.5); }
    64%  { clip-path: inset(0 0 0 0);         filter: brightness(1.7) saturate(0.9); }
    100% { clip-path: inset(0 0 0 0);         filter: none; }
  }

  /* Jemne kolisani jasu — luminofor nikdy nesviti uplne stejne.
     Rozsah jsou dve procenta, takze to clovek spis citi nez vidi. */
  .hero-wide {
    /* Vsechny tri v JEDNE deklaraci — kdyby byly ve dvou pravidlech,
       pozdejsi by drivejsi prepsalo a jedna z nich by se ztratila. */
    animation:
      hero-put 40s ease-in-out infinite alternate,
      crt-mihotani 5.5s ease-in-out infinite,
      crt-zapnuti 0.9s cubic-bezier(0.2, 0.9, 0.2, 1) 1;
  }
  @keyframes crt-mihotani {
    0%, 100% { filter: brightness(1); }
    47%      { filter: brightness(1.02); }
    52%      { filter: brightness(0.985); }
  }

  /* Rozhozena stopa. Nadpis se na okamzik posune a barevne roztrhne,
     jako kdyz televizi vypadne synchronizace. Deje se to jednou za deset
     sekund a trva to zlomek vteriny, aby to bavilo a nerusilo. */
  .hero h1 .grad {
    animation:
      preliv 14s ease-in-out infinite,
      crt-stopa 10s steps(1, end) infinite;
  }
  @keyframes crt-stopa {
    0%, 92% {
      transform: translateX(0);
      filter: none;
    }
    93% {
      transform: translateX(-3px);
      filter: drop-shadow(2px 0 0 rgba(255, 0, 80, 0.85))
              drop-shadow(-2px 0 0 rgba(0, 220, 255, 0.85));
    }
    95% {
      transform: translateX(4px);
      filter: drop-shadow(-3px 0 0 rgba(255, 0, 80, 0.8))
              drop-shadow(3px 0 0 rgba(0, 220, 255, 0.8));
    }
    97%, 100% {
      transform: translateX(0);
      filter: none;
    }
  }

  /* Vodorovna cara, ktera obcas projede hero — zbytkovy signal na trubici. */
  .hero-inner::before {
    box-shadow: 0 0 120px 40px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero,
    .hero-wide,
    .hero h1 .grad {
      animation: none !important;
      clip-path: none !important;
      filter: none !important;
    }
    /* Vinetace a zar zustavaji — nehybou se, jen dotvareji vzhled. */
  }

  /* ================= ukazatel polohy pri rolovani ================= */
  .poloha {
    position: fixed;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    pointer-events: none;   /* klikat jde jen na tecky */
  }
  .poloha-procento {
    font-family: var(--font-pixel);
    font-size: 0.52rem;
    letter-spacing: 0.5px;
    color: var(--accent-3);
    text-shadow: 0 0 10px color-mix(in srgb, var(--accent-3) 50%, transparent);
  }
