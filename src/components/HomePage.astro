---
import PlatformCard from './PlatformCard.astro';
import GameCard from './GameCard.astro';
import HardwareArt from './HardwareArt.astro';
import { platformsByType, allGames, stats } from '../lib/data';
import { hardware } from '../data/hardware';
import { t, navHref, localizePath, DEFAULT_LOCALE } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

const { locale = DEFAULT_LOCALE } = Astro.props as { locale?: Locale };
const lp = (p: string) => navHref(locale, p);
const groups = platformsByType();

// Sest samostatnych sekci s kartami delalo z uvodni strany 26 obrazovek.
// Vsechny platformy jsou proto v JEDNE mrizce a typ se prepina zalozkami —
// strana je kratka a zadna platforma nezmizi za proklikem.
const allPlatforms = groups.flatMap((g) => g.items.map((p) => ({ p, type: g.type })));
const featured = allGames.filter((g) => g.flags.includes('mustplay')).slice(0, 6);
---

<section class="hero scanlines">
  <div class="container hero-inner">
    <p class="eyebrow">{t(locale, 'home.eyebrow')}</p>
    <h1>
      {t(locale, 'home.h1a')} <span class="grad">{t(locale, 'home.h1b')}</span><br />
      {t(locale, 'home.h1c')}
    </h1>
    <p class="lead muted">{t(locale, 'home.lead')}</p>
    <div class="cta">
      <a class="btn btn-primary" href={lp('/platformy')}>{t(locale, 'home.ctaPlatforms')}</a>
      <a class="btn" href={lp('/hry')}>{t(locale, 'home.ctaGames')}</a>
    </div>
    <ul class="stats">
      <li><span class="num pixel">{stats.platforms}</span><span class="lbl">{t(locale, 'platforms.count')}</span></li>
      <li><span class="num pixel">{stats.games}</span><span class="lbl">{t(locale, 'games.count')}</span></li>
      <li><span class="num pixel">{stats.gameImages}</span><span class="lbl">{t(locale, 'home.images')}</span></li>
    </ul>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="sec-head">
      <div>
        <p class="eyebrow">{t(locale, 'nav.platforms')}</p>
        <h2>{t(locale, 'home.platformsTag')}</h2>
      </div>
      <span class="muted count">{stats.platforms} {t(locale, 'platforms.count')}</span>
    </div>

    <div class="type-tabs" role="tablist">
      <button class="chip on" data-type="" type="button">
        {t(locale, 'games.allLetters')} <span class="tt-n">{allPlatforms.length}</span>
      </button>
      {groups.map((g) => (
        <button class="chip" data-type={g.type} type="button">
          {t(locale, `type.${g.type}.label`)} <span class="tt-n">{g.items.length}</span>
        </button>
      ))}
    </div>

    <div class="grid grid-platforms" id="plat-grid">
      {allPlatforms.map(({ p, type }) => (
        <div class="plat-cell" data-type={type}>
          <PlatformCard platform={p} locale={locale} />
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section hw-sec">
  <div class="container">
    <div class="sec-head">
      <div>
        <p class="eyebrow">{t(locale, 'home.hwEyebrow')}</p>
        <h2>{t(locale, 'home.hwTitle')}</h2>
      </div>
      <a class="muted link" href={lp('/hardware')}>{t(locale, 'home.hwAll')}</a>
    </div>
    <div class="grid grid-hw">
      {hardware.map((h) => (
        <a class="card hw-card" href={lp(`/hardware/${h.slug}`)} style={`--c1:${h.color}; --c2:${h.color2}`}>
          {h.photo ? (
            <div class={`hw-photo${h.photo.fit === 'contain' ? ' contain' : ''}`}>
              <img src={h.photo.src} alt={h.name} loading="lazy" />
            </div>
          ) : (
            <HardwareArt art={h.art} color={h.color} color2={h.color2} />
          )}
          <div class="hw-body">
            <h3>{h.name}</h3>
            <p class="muted">{h.kind}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

{
  featured.length > 0 && (
    <section class="section featured">
      <div class="container">
        <div class="sec-head">
          <div>
            <p class="eyebrow">{t(locale, 'home.featEyebrow')}</p>
            <h2>{t(locale, 'home.featTitle')}</h2>
          </div>
          <a class="muted link" href={lp('/hry')}>{t(locale, 'home.gamesAll')}</a>
        </div>
        <div class="grid grid-games">
          {featured.map((g) => <GameCard game={g} platform={g.platform} showPlatform locale={locale} />)}
        </div>
      </div>
    </section>
  )
}

<style>
  .hero {
    position: relative;  /* kotva pro mrizku v ::after */
    border-bottom: 1px solid var(--border-soft);
    background:
      radial-gradient(800px 380px at 18% -10%, rgba(255, 62, 127, 0.16), transparent 60%),
      radial-gradient(700px 360px at 92% 0%, rgba(54, 226, 255, 0.12), transparent 55%);
  }
  .hero-inner { padding-block: 72px 60px; max-width: 760px; }
  h1 { font-size: clamp(2.3rem, 6vw, 3.7rem); margin-block: 14px 18px; }
  .grad {
    background: linear-gradient(110deg, var(--accent), var(--accent-3) 60%, var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead { font-size: 1.12rem; max-width: 620px; }
  .lead strong { color: var(--text); }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
  .stats { display: flex; gap: 38px; margin-top: 44px; flex-wrap: wrap; }
  .stats li { display: flex; flex-direction: column; gap: 4px; }
  .num { font-size: 1.5rem; color: var(--accent-3); }
  .lbl { font-size: 0.82rem; color: var(--muted); text-transform: uppercase; letter-spacing: 1px; }
  .sec-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
  }
  .sec-head h2 { font-size: clamp(1.3rem, 3vw, 1.7rem); margin-top: 4px; }
  .sec-head .count { font-size: 0.85rem; white-space: nowrap; }
  .link:hover { color: var(--accent); }
  .featured { background: var(--bg-2); border-block: 1px solid var(--border-soft); }
  .grid-hw { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; }
  .hw-photo {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background:
      radial-gradient(120% 120% at 75% 10%, color-mix(in srgb, var(--c1) 30%, transparent), transparent 60%),
      linear-gradient(160deg, var(--c2), #0b0c11);
  }
  .hw-photo img { width: 100%; height: 100%; object-fit: contain; padding: 16px; display: block; }
  .hw-card { display: flex; flex-direction: column; }
  .hw-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--c1) 55%, var(--border));
    box-shadow: var(--shadow);
  }
  .hw-body { padding: 13px 15px 15px; }
  .hw-body h3 { font-size: 1rem; line-height: 1.25; }
  .hw-body .muted { font-size: 0.82rem; margin-top: 3px; }
  .section + .section { padding-top: 8px; }

  .type-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 4px; }
  .type-tabs .tt-n {
    margin-left: 6px; font-size: 0.78em; color: var(--muted); font-variant-numeric: tabular-nums;
  }
  .type-tabs .chip.on .tt-n { color: inherit; opacity: 0.75; }
  .plat-cell[hidden] { display: none; }

  /* --- hero --- */
  .hero-inner { position: relative; z-index: 1; }
  .hero::after {
    /* mrizka jako na starem CRT, mizi smerem dolu */
    content: '';
    position: absolute; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(color-mix(in srgb, var(--accent) 9%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--accent) 9%, transparent) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 78%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 78%);
  }
  .hero h1 { letter-spacing: -0.02em; }
  .hero .stats {
    gap: 28px; padding: 18px 22px; border-radius: 14px;
    border: 1px solid var(--border-soft);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    backdrop-filter: blur(6px);
    width: fit-content;
  }
  .hero .stats .num { font-size: 1.9rem; line-height: 1; }
  @media (max-width: 640px) {
    .hero .stats { gap: 18px; padding: 14px 16px; width: 100%; }
    .hero .stats .num { font-size: 1.45rem; }
  }
</style>
<script is:inline>
  (function () {
    var grid = document.getElementById('plat-grid');
    if (!grid) return;
    var tabs = document.querySelectorAll('.type-tabs .chip');
    var cells = grid.querySelectorAll('.plat-cell');
    for (var i = 0; i < tabs.length; i++) {
      tabs[i].addEventListener('click', function (e) {
        var want = e.currentTarget.getAttribute('data-type');
        for (var j = 0; j < tabs.length; j++) tabs[j].classList.toggle('on', tabs[j] === e.currentTarget);
        for (var k = 0; k < cells.length; k++) {
          cells[k].hidden = !!want && cells[k].getAttribute('data-type') !== want;
        }
      });
    }
  })();
</script>
