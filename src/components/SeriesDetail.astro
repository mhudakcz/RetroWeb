---
import { localeData, mdBlock, mdInline, normGameName } from '../lib/data';
import GameEntryList from './GameEntryList.astro';
import { t, localizePath, DEFAULT_LOCALE } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

interface Props { slug: string; locale?: Locale; }
const { slug, locale = DEFAULT_LOCALE } = Astro.props;
const s = localeData(locale).getSeries(slug)!;
const intro = mdBlock(s.intro);
const years = s.games.map((g) => parseInt(g.year || '0')).filter(Boolean);
const span = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : null;

// JEDEN TITUL = jeden záznam, platformy jen vyjmenované. Dřív se stejná hra
// v seznamu opakovala za každou platformu (Lemmings desetkrát).
const byTitle = new Map<
  string,
  { g: (typeof s.games)[number]; year: number; versions: (typeof s.games)[number][] }
>();
for (const g of s.games) {
  const key = normGameName(g.name);
  const y = parseInt(g.year || '') || g.platform.year;
  const e = byTitle.get(key);
  if (e) {
    e.versions.push(g);
    if (y < e.year) { e.year = y; e.g = g; }
  } else {
    byTitle.set(key, { g, year: y, versions: [g] });
  }
}
const platCount = new Set(s.games.map((g) => g.platform.slug)).size;
const entries = [...byTitle.values()]
  .map((e) => ({
    ...e,
    versions: [...e.versions].sort((a, b) => a.platform.year - b.platform.year),
  }))
  .sort((a, b) => a.year - b.year);
---

<article class="container narrow">
  <nav class="crumbs muted" aria-label="breadcrumb">
    <a href={localizePath(locale, '/serie')}>{t(locale, 'series.title')}</a> <span>/</span> <span>{s.name}</span>
  </nav>

  <header class="head">
    <p class="eyebrow">{t(locale, 'series.eyebrow')}</p>
    <h1>{s.name}</h1>
    <div class="facts">
      <span class="tag">{entries.length} {t(locale, 'series.titles')}</span>
      {s.gameCount > entries.length && (
        <span class="tag">{s.gameCount} {t(locale, 'series.versions')}</span>
      )}
      {span && <span class="tag">⏱ {span}</span>}
      <span class="tag">{platCount} {t(locale, 'platforms.count')}</span>
    </div>
  </header>

  {s.image && (
    <figure class="series-art">
      <img src={s.image} alt={`${s.name} – obaly dílů série`} decoding="async" />
    </figure>
  )}

  {intro && <div class="article prose" set:html={intro} />}

  <section class="games">
    <h2 class="sec-title">{t(locale, 'series.games')} <span class="muted">({entries.length})</span></h2>
    <GameEntryList games={s.games} locale={locale} />
  </section>
</article>

<style>
  .narrow { max-width: 920px; }
  .crumbs { padding-top: 26px; font-size: 0.86rem; }
  .crumbs a { color: var(--accent); }
  .head { margin: 18px 0 8px; }
  .eyebrow {
    font-family: var(--font-pixel); font-size: 0.6rem; text-transform: uppercase;
    letter-spacing: 0.5px; color: color-mix(in srgb, var(--accent) 80%, var(--text));
  }
  .head h1 { font-size: clamp(1.9rem, 5vw, 2.9rem); margin-block: 8px 12px; }
  .facts { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag {
    font-size: 0.82rem; padding: 0.4em 0.75em; border-radius: 999px;
    background: var(--surface); border: 1px solid var(--border); color: var(--muted);
  }
  .series-art {
    margin: 22px 0 4px; border-radius: var(--radius); overflow: hidden;
    border: 1px solid var(--border-soft); line-height: 0;
  }
  .series-art img { width: 100%; height: auto; display: block; }
  .article { margin: 24px 0 8px; font-size: 1.04rem; }
  .games { margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--border-soft); }
  .sec-title { font-size: clamp(1.3rem, 3vw, 1.6rem); margin-bottom: 18px; }
</style>
