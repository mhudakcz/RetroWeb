---
import { localeData, playtimeLabel, mdBlock, mdInline, gameNeighbors, studioLink, seriesOfGame, sameGameElsewhere, versionNote, normGameName } from '../lib/data';
import Lightbox from './Lightbox.astro';
import { t, localizePath, DEFAULT_LOCALE } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

interface Props { slug: string; locale?: Locale; }
const { slug, locale = DEFAULT_LOCALE } = Astro.props;
const { getGame } = localeData(locale);
const game = getGame(slug)!;
const platform = game.platform;

// Chybejici preklad se nahrazuje ceskym originalem. Upozorneni davame jen kdyz
// je nepreloceny hlavni text — u samotne uvodni vety by hlaska stala skoro
// vsude a citelnost stranky by tim jen utrpela. Vetu resi atribut lang.
// Popisek snimku je v datasetu cesky. Preklada se podle 'kind', ktery parser
// uklada vedle nej — bez toho stalo na anglicke strance "Titulni obrazovka".
const shotLabel = (s: { kind: string; label: string }) =>
  ['box', 'snap', 'title'].includes(s.kind) ? t(locale, `shot.${s.kind}`) : s.label;

const fb = game.fallback ?? [];
const bodyInCzech = fb.includes('article') || fb.includes('detail');
const teaserInCzech = fb.includes('teaser');
const lp = (p: string) => localizePath(locale, p);

const { prev, next } = gameNeighbors(platform, game.slug);
const gamePos = platform.games.findIndex((g) => g.slug === game.slug) + 1;
const gameTotal = platform.games.length;
const pool = platform.games.filter((g) => g.slug !== game.slug);
const startI = pool.length ? (gamePos - 1) % pool.length : 0;
const related = [...pool, ...pool].slice(startI, startI + 8);
const nameHtml = mdInline(game.name);
const shots = game.gallery.filter((g) => g.kind !== 'box' && g.src !== game.image);
const playtime = playtimeLabel(game.length, game.est);
const gameSeries = seriesOfGame(game.name, localeData(locale).series, game.slug);
const elsewhere = sameGameElsewhere(game, localeData(locale).allGames);
const verNote = elsewhere.length > 0 ? versionNote(game.name, locale) : null;
// další díly série — bez těch, které už jsou v „Tentýž titul jinde"
const elsewhereSlugs = new Set([game.slug, ...elsewhere.map((g) => g.slug)]);
const seriesPicks = gameSeries.flatMap((s) =>
  s.games.filter((g) => !elsewhereSlugs.has(g.slug)).map((g) => ({ g, series: s })),
);
// jeden titul = jeden odkaz. Bez toho tu Prince of Persia: The Sands of Time
// visel třikrát (PS2, GCN, Xbox) — stejná hra, jen jiná platforma.
const seenTitle = new Map<string, { g: (typeof seriesPicks)[number]['g']; plats: string[] }>();
for (const { g } of seriesPicks) {
  const key = normGameName(g.name);
  const e = seenTitle.get(key);
  if (e) {
    if (!e.plats.includes(g.platform.short)) e.plats.push(g.platform.short);
  } else {
    seenTitle.set(key, { g, plats: [g.platform.short] });
  }
}
const siblings = [...seenTitle.values()].slice(0, 12);
const clean = (s: string) => s.replace(/[*_\x60]/g, '');


const FLAG_T: Record<string, string> = {
  homebrew: t(locale, 'flag.homebrew'), mustplay: t(locale, 'flag.mustplay'),
  mature: t(locale, 'flag.mature'), puzzle: t(locale, 'flag.puzzle'),
};
const noDetail = {
  cs: `U téhle hry zatím nemáme delší komentář. Patří ale do kurátorského výběru pro`,
  en: `We don't have a longer write-up for this game yet. It's still part of the curated selection for`,
  de: `Zu diesem Spiel gibt es noch keinen längeren Text. Es gehört aber zur kuratierten Auswahl für`,
  fr: `Nous n'avons pas encore de texte plus long pour ce jeu. Il fait toutefois partie de la sélection pour`,
}[locale];
const posText = {
  cs: ['Hra', 'z', 'pro'], en: ['Game', 'of', 'for'], de: ['Spiel', 'von', 'für'],
  fr: ['Jeu', 'sur', 'pour'],
}[locale];
---

<article class="container narrow">
  <nav class="crumbs muted" aria-label="breadcrumb">
    <a href={lp('/hry')}>{t(locale, 'nav.games')}</a> <span>/</span>
    <a href={lp(`/platformy/${platform.slug}`)}>{platform.name}</a> <span>/</span>
    <span>{clean(game.name)}</span>
  </nav>

  {(prev || next) && (
    <nav class="pager-top" aria-label="pager">
      {prev ? (
        <a class="pt-link prev" href={lp(`/hry/${prev.slug}`)}><span class="dir">←</span><span class="pn" set:html={mdInline(prev.name)} /></a>
      ) : <span />}
      <span class="pt-pos muted">{gamePos} / {gameTotal}</span>
      {next ? (
        <a class="pt-link next" href={lp(`/hry/${next.slug}`)}><span class="pn" set:html={mdInline(next.name)} /><span class="dir">→</span></a>
      ) : <span />}
    </nav>
  )}

  <header class:list={['head', { 'has-art': game.image }]}>
    {game.image && (
      <div class="boxart" style={`--c1:${platform.color}; --c2:${platform.color2}`}>
        <img src={game.image} alt={`${clean(game.name)} – boxart`} decoding="async"
             data-zoom={clean(game.name)} title={t(locale, 'zoom.open')} />
      </div>
    )}
    <div class="head-text">
      <a class="platform-pill" href={lp(`/platformy/${platform.slug}`)} style={`--c1:${platform.color}`}>
        <span class="pp-short pixel">{platform.short}</span>{platform.name}
      </a>
      <h1 set:html={nameHtml} />
      <div class="facts">
        {game.genre && <span class="tag tag-genre" style={`--c1:${platform.color}`}>{game.genre}</span>}
        {game.year && <span class="tag">{game.year}</span>}
        {game.os?.map((o) => <span class="tag tag-os">{o}</span>)}
        {game.studio && (studioLink(game.studio)
          ? <a class="tag tag-studio" href={lp(`/studia/${studioLink(game.studio)}`)}>{game.studio}</a>
          : <span class="tag">{game.studio}</span>)}
        {gameSeries.map((s) => (
          <a class="tag tag-series" href={lp(`/serie/${s.slug}`)}>{s.name}</a>
        ))}
        {playtime && <span class="tag">⏱ {playtime}</span>}
        {game.players && <span class="tag tag-players">👥 {game.players}</span>}
        {game.rating && <span class="tag tag-rating">🛡 {game.rating}</span>}
        {game.flags.map((f) => <span class="tag tag-flag">{FLAG_T[f]}</span>)}
      </div>
    </div>
  </header>

  {shots.length > 0 && (
    <section class="shotbar">
      {shots.map((s) => (
        <figure>
          <img src={s.src} alt={`${clean(game.name)} – ${shotLabel(s)}`} loading="lazy" decoding="async"
               data-zoom={shotLabel(s)} data-pixel title={t(locale, 'zoom.open')} />
          <figcaption>{shotLabel(s)}</figcaption>
        </figure>
      ))}
    </section>
  )}

  {game.teaser && (
    <p class="teaser" lang={teaserInCzech ? 'cs' : undefined} set:html={mdInline(game.teaser)}></p>
  )}

  {bodyInCzech && (
    <p class="i18n-pending">
      <strong>{t(locale, 'i18n.pending.title')}</strong> {t(locale, 'i18n.pending.body')}
    </p>
  )}

  {game.article ? (
    <div class="prose detail article" lang={bodyInCzech ? 'cs' : undefined} set:html={mdBlock(game.article)} />
  ) : game.detail ? (
    <div class="prose detail" lang={bodyInCzech ? 'cs' : undefined} set:html={mdBlock(game.detail)} />
  ) : (
    <div class="no-detail">
      <p class="muted">{noDetail} <a href={lp(`/platformy/${platform.slug}`)}>{platform.name}</a>.</p>
    </div>
  )}

  {(game.link || game.playUrl) && (
    <div class="game-links" style={`--c1:${platform.color}`}>
      {game.playUrl && <a class="g-btn play" href={game.playUrl} target="_blank" rel="noopener noreferrer">{t(locale, 'game.playOnline')}</a>}
      {game.link && <a class="g-btn" href={game.link} target="_blank" rel="noopener noreferrer">{t(locale, 'game.official')}</a>}
    </div>
  )}

  {(prev || next) && (
    <>
    <p class="pager-pos muted">{posText[0]} <strong>{gamePos}</strong> {posText[1]} <strong>{gameTotal}</strong> {posText[2]} <a href={lp(`/platformy/${platform.slug}`)}>{platform.name}</a></p>
    <nav class="pager" aria-label="pager">
      {prev ? (
        <a class="pager-link prev" href={lp(`/hry/${prev.slug}`)}>
          {prev.image && <img class="pager-thumb" src={prev.image} alt="" loading="lazy" />}
          <span class="pl-text"><span class="dir">{t(locale, 'game.prev')}</span><span class="pn" set:html={mdInline(prev.name)} /></span>
        </a>
      ) : <span />}
      {next ? (
        <a class="pager-link next" href={lp(`/hry/${next.slug}`)}>
          <span class="pl-text"><span class="dir">{t(locale, 'game.next')}</span><span class="pn" set:html={mdInline(next.name)} /></span>
          {next.image && <img class="pager-thumb" src={next.image} alt="" loading="lazy" />}
        </a>
      ) : <span />}
    </nav>
    </>
  )}

  {elsewhere.length > 0 && (
    <section class="elsewhere">
      <h2 class="els-title">{t(locale, 'game.alsoOn')} <span class="muted">({elsewhere.length})</span></h2>
      {verNote && <p class="els-note">{verNote}</p>}
      <div class="els-row">
        {elsewhere.map((g) => (
          <a class="els-item" href={lp(`/hry/${g.slug}`)} style={`--c1:${g.platform.color}; --c2:${g.platform.color2}`}>
            <span class="els-thumb">
              {g.image ? <img src={g.image} alt="" loading="lazy" decoding="async" />
                       : <span class="els-ph pixel">{g.platform.short}</span>}
            </span>
            <span class="els-text">
              <span class="els-plat">{g.platform.name}</span>
              {g.year && <span class="els-year muted">{g.year}</span>}
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  {siblings.length > 0 && (
    <section class="elsewhere">
      <h2 class="els-title">
        {t(locale, 'game.sameSeries')}
        {gameSeries.map((s) => (
          <> <a class="els-serieslink" href={lp(`/serie/${s.slug}`)}>{s.name} →</a></>
        ))}
      </h2>
      <div class="els-row">
        {siblings.map(({ g, plats }) => (
          <a class="els-item" href={lp(`/hry/${g.slug}`)} style={`--c1:${g.platform.color}; --c2:${g.platform.color2}`}>
            <span class="els-thumb">
              {g.image ? <img src={g.image} alt="" loading="lazy" decoding="async" />
                       : <span class="els-ph pixel">{g.platform.short}</span>}
            </span>
            <span class="els-text">
              <span class="els-plat" set:html={mdInline(g.name)} />
              <span class="els-year muted">{plats.join(' · ')}{g.year ? ` · ${g.year}` : ''}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="related">
      <div class="related-head">
        <h2>{t(locale, 'game.moreFrom')} {platform.name}</h2>
        <a class="all-link" href={lp(`/platformy/${platform.slug}`)}>{t(locale, 'game.all')} {platform.gameCount} →</a>
      </div>
      <div class="more-wrap">
        <button class="more-nav prev" type="button" aria-label="←" hidden>‹</button>
        <div class="more-row" id="moreRow">
          {related.map((g) => (
            <a class="more-item" href={lp(`/hry/${g.slug}`)} title={clean(g.name)}>
              <span class="more-thumb" style={`--c1:${platform.color}; --c2:${platform.color2}`}>
                {g.image ? <img src={g.image} alt="" loading="lazy" /> : <span class="more-ph pixel">{platform.short}</span>}
              </span>
              <span class="more-name" set:html={mdInline(g.name)} />
            </a>
          ))}
        </div>
        <button class="more-nav next" type="button" aria-label="→" hidden>›</button>
      </div>
    </section>
  )}
</article>

<Lightbox locale={locale} />

<script is:inline>
  (function () {
    // Snimky ze hry jsou v nativnim rozliseni konzole (GBA 240x160, GB 160x144).
    // Kdyz se roztahnou na sirku sloupce, vyjde nesoudely nasobek a pri
    // image-rendering: pixelated je pak cast pixelu 1px a cast 2px — obraz
    // vypada kostrbate. Sirka se proto zaokrouhli dolu na cely nasobek.
    function celyNasobek(im, maxSirka) {
      var nat = im.naturalWidth;
      if (!nat) return;
      var k = Math.max(1, Math.floor(maxSirka / nat));
      im.style.width = (nat * k) + 'px';
      im.style.height = 'auto';
    }
    var shots = document.querySelectorAll('.shotbar img');
    function prepocitat() {
      for (var i = 0; i < shots.length; i++) celyNasobek(shots[i], shots[i].parentElement.clientWidth);
    }
    for (var i = 0; i < shots.length; i++) {
      if (shots[i].complete) celyNasobek(shots[i], shots[i].parentElement.clientWidth);
      else shots[i].addEventListener('load', prepocitat);
    }
    window.addEventListener('resize', prepocitat);
  })();
</script>

<script is:inline>
  (function () {
    const row = document.getElementById('moreRow');
    if (!row) return;
    const wrap = row.parentElement;
    const prev = wrap.querySelector('.more-nav.prev');
    const next = wrap.querySelector('.more-nav.next');
    const step = () => Math.max(180, Math.round(row.clientWidth * 0.8));
    function update() {
      const max = row.scrollWidth - row.clientWidth - 2;
      const overflow = max > 4;
      prev.hidden = !overflow || row.scrollLeft <= 2;
      next.hidden = !overflow || row.scrollLeft >= max;
    }
    prev.addEventListener('click', () => row.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => row.scrollBy({ left: step(), behavior: 'smooth' }));
    row.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

<style>
  .narrow { max-width: 800px; }
  .crumbs { padding-top: 26px; font-size: 0.86rem; }
  .crumbs a:hover { color: var(--accent); }
  .crumbs span { margin-inline: 4px; }
  .head { padding-block: 24px 6px; border-bottom: 1px solid var(--border-soft); margin-bottom: 24px; }
  /* `1fr` neznamená „zbytek": položka gridu má výchozí min-width:auto, takže ji
     dlouhý obsah roztáhne. `minmax(0, 1fr)` jí dovolí se smrsknout. */
  .head.has-art { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 26px; align-items: center; }
  .boxart {
    border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border);
    background: radial-gradient(120% 120% at 80% 0%, color-mix(in srgb, var(--c1) 25%, transparent), transparent 60%), linear-gradient(160deg, color-mix(in srgb, var(--c2) 80%, #000), #0b0c11);
    box-shadow: var(--shadow);
  }
  .boxart img { width: 100%; max-height: 280px; object-fit: contain; padding: 14px; }
  @media (max-width: 560px) { .head.has-art { grid-template-columns: 110px minmax(0, 1fr); gap: 14px; } }
  .platform-pill { display: inline-flex; align-items: center; gap: 9px; font-size: 0.88rem; font-weight: 600; color: var(--muted); }
  .platform-pill:hover { color: var(--text); }
  .pp-short { font-size: 0.55rem; padding: 0.45em 0.6em; border-radius: 7px; color: var(--text); background: color-mix(in srgb, var(--c1) 35%, var(--surface-2)); border: 1px solid color-mix(in srgb, var(--c1) 55%, var(--border)); }
  h1 { font-size: clamp(1.8rem, 5vw, 2.7rem); margin-block: 12px 16px; }
  .facts { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag-genre { color: color-mix(in srgb, var(--c1) 70%, var(--text)); border-color: color-mix(in srgb, var(--c1) 40%, var(--border)); }
  .tag-os { color: #9fd8ff; border-color: color-mix(in srgb, #9fd8ff 40%, var(--border)); }
  .tag-players { color: var(--accent-2, #6ee7c7); border-color: color-mix(in srgb, var(--accent-2, #6ee7c7) 40%, var(--border)); }
  .tag-rating { color: #d8b4fe; border-color: color-mix(in srgb, #d8b4fe 40%, var(--border)); }
  .tag-studio { color: color-mix(in srgb, var(--accent) 75%, var(--text)); border-color: color-mix(in srgb, var(--accent) 35%, var(--border)); }
  .tag-studio:hover { border-color: var(--accent); }
  .tag-series { color: color-mix(in srgb, var(--accent) 75%, var(--text)); border-color: color-mix(in srgb, var(--accent) 35%, var(--border)); text-decoration: none; }
  .tag-series:hover { border-color: var(--accent); }
  .elsewhere { margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--border-soft); }
  .els-title { font-size: clamp(1.15rem, 2.6vw, 1.4rem); margin-bottom: 14px; }
  .els-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .els-item {
    display: flex; align-items: center; gap: 10px; padding: 8px 12px 8px 8px;
    border: 1px solid var(--border); border-radius: 999px; background: var(--surface);
    text-decoration: none; color: inherit;
  }
  .els-item:hover { border-color: var(--c1); }
  .els-thumb {
    width: 34px; height: 34px; border-radius: 50%; overflow: hidden; flex: none;
    display: grid; place-items: center;
    background: radial-gradient(120% 120% at 50% 20%, var(--c1), var(--c2));
  }
  .els-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .els-ph { font-size: 0.5rem; color: #fff; }
  .els-text { display: flex; flex-direction: column; line-height: 1.25; }
  .els-plat { font-size: 0.88rem; }
  .els-year { font-size: 0.76rem; }
  .els-note {
    margin: 0 0 14px; font-size: 0.95rem; color: var(--muted);
    border-left: 3px solid color-mix(in srgb, var(--accent) 45%, var(--border));
    padding-left: 12px; max-width: 66ch;
  }
  .els-serieslink { color: var(--accent); text-decoration: none; font-size: 0.9rem; font-weight: 500; }
  .els-serieslink:hover { text-decoration: underline; }
  .teaser { font-size: 1.15rem; line-height: 1.55; color: var(--text); border-left: 3px solid var(--accent); padding: 4px 0 4px 16px; margin-bottom: 22px; }
  .game-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .g-btn { display: inline-flex; align-items: center; gap: 0.5em; padding: 0.7em 1.15em; border-radius: 999px; font-weight: 600; font-size: 0.92rem; color: #fff; background: linear-gradient(135deg, color-mix(in srgb, var(--c1) 70%, #000), color-mix(in srgb, var(--c1) 42%, #000)); border: 1px solid color-mix(in srgb, var(--c1) 60%, var(--border)); transition: transform 0.15s ease, box-shadow 0.15s ease; }
  .g-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 22px -8px var(--c1); }
  .g-btn.play { background: linear-gradient(135deg, var(--accent), #ff7aa8); border-color: transparent; color: #1a0710; }
  .detail { font-size: 1.06rem; }
  .no-detail { background: var(--surface); border: 1px solid var(--border-soft); border-radius: var(--radius); padding: 18px 20px; }
  .no-detail a { color: var(--accent); }
  .shotbar { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin: 22px 0 26px; }
  .shotbar figure { margin: 0; background: #0b0c11; border: 1px solid var(--border-soft); border-radius: var(--radius); overflow: hidden; }
  /* Zadny vnuceny pomer stran: kazda konzole ma jiny (GBA 3:2, GB 10:9,
     NES 8:7) a letterbox do 4:3 jen pridaval prazdne pruhy. Sirku na cely
     nasobek nativniho rozliseni dopocitava skript vyse. */
  .shotbar figure { display: grid; place-items: center; }
  .shotbar img { display: block; max-width: 100%; height: auto; background: #0b0c11; image-rendering: pixelated; }
  .shotbar figcaption { padding: 8px 12px; font-size: 0.82rem; color: var(--muted); font-weight: 600; text-align: center; }
  .related { margin-top: 44px; padding-top: 24px; border-top: 1px solid var(--border-soft); }
  .related-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .related-head h2 { font-size: 1.15rem; }
  .all-link { font-size: 0.85rem; font-weight: 600; color: var(--accent); white-space: nowrap; }
  .all-link:hover { text-decoration: underline; }
  .more-wrap { position: relative; }
  .more-row { display: grid; grid-auto-flow: column; grid-auto-columns: 92px; gap: 12px; overflow-x: auto; scroll-behavior: smooth; scrollbar-width: none; }
  .more-row::-webkit-scrollbar { display: none; }
  .more-nav { position: absolute; top: 46px; transform: translateY(-50%); z-index: 3; width: 34px; height: 34px; border-radius: 999px; border: 1px solid var(--border); background: color-mix(in srgb, var(--surface) 92%, #000); color: var(--text); font-size: 1.3rem; line-height: 1; cursor: pointer; display: grid; place-items: center; box-shadow: var(--shadow); transition: border-color 0.15s ease, background 0.15s ease; }
  .more-nav:hover { border-color: var(--accent); }
  .more-nav.prev { left: -6px; }
  .more-nav.next { right: -6px; }
  .more-nav[hidden] { display: none; }
  .more-item { display: flex; flex-direction: column; gap: 6px; color: var(--text); }
  .more-thumb { aspect-ratio: 1 / 1; border-radius: 10px; overflow: hidden; border: 1px solid var(--border); display: grid; place-items: center; background: radial-gradient(125% 125% at 50% 12%, color-mix(in srgb, var(--c1) 40%, #2a2e3a), color-mix(in srgb, var(--c2) 70%, #15171f) 72%, #111319); transition: border-color 0.15s ease, transform 0.15s ease; }
  .more-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .more-ph { font-size: 0.62rem; color: #fff; opacity: 0.85; }
  .more-item:hover .more-thumb { transform: translateY(-3px); border-color: color-mix(in srgb, var(--c1) 60%, var(--border)); }
