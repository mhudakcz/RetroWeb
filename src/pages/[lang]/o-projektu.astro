---
import Base from '../../layouts/Base.astro';
import AboutPage from '../../components/AboutPage.astro';
import type { Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'de' } }];
}
const locale = Astro.params.lang as Locale;
const DESC = {
  en: 'About RetroWeb — what it covers, for which consoles, and how it came about.',
  de: 'Über RetroWeb — was es umfasst, für welche Konsolen und wie es entstanden ist.',
}[locale];
const TITLE = { en: 'About', de: 'Über' }[locale];
---

<Base title={TITLE} description={DESC} locale={locale} localized>
  <AboutPage locale={locale} />
</Base>
