---
import Base from '../../../layouts/Base.astro';
import GameDetail from '../../../components/GameDetail.astro';
import { allGames, localeData } from '../../../lib/data';
import type { Locale } from '../../../lib/i18n';
import { BUILD_LOCALES } from '../../../lib/i18n';

export function getStaticPaths() {
  const langs = BUILD_LOCALES;
  return langs.flatMap((lang) => allGames.map((g) => ({ params: { lang, slug: g.slug } })));
}
const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug!;
const game = localeData(lang).getGame(slug)!;
const platform = game.platform;
---

<Base
  title={game.name.replace(/[*_\x60]/g, '')}
  description={game.teaser ?? (game.detail ? game.detail.replace(/[*_\x60]/g, '').slice(0, 155) : `${game.name} — ${platform.name}.`)}
  accent={platform.color}
  locale={lang}
  localized
>
  <GameDetail slug={slug} locale={lang} />
</Base>
