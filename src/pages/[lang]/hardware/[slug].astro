---
import Base from '../../../layouts/Base.astro';
import HardwareDetail from '../../../components/HardwareDetail.astro';
import { hardware, getHardware } from '../../../data/hardware';
import { hardwareMetaLoc } from '../../../lib/data';
import type { Locale } from '../../../lib/i18n';
import { BUILD_LOCALES } from '../../../lib/i18n';

export function getStaticPaths() {
  const langs = BUILD_LOCALES;
  return langs.flatMap((lang) => hardware.map((h) => ({ params: { lang, slug: h.slug } })));
}
const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug!;
const hw = getHardware(slug)!;
const meta = hardwareMetaLoc(lang)[slug] || {};
---

<Base title={hw.name} description={meta.tagline ?? hw.tagline} accent={hw.color} locale={lang} localized>
  <HardwareDetail slug={slug} locale={lang} />
</Base>
