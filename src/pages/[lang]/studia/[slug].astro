---
import Base from '../../../layouts/Base.astro';
import StudioDetail from '../../../components/StudioDetail.astro';
import { studios, localeData } from '../../../lib/data';
import type { Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  const langs: Locale[] = ['en', 'de'];
  return langs.flatMap((lang) => studios.map((s) => ({ params: { lang, slug: s.slug } })));
}
const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug!;
const studio = localeData(lang).getStudio(slug)!;
const w = { en: 'games', de: 'Spiele' }[lang];
---

<Base title={studio.name} description={`${studio.name} — ${studio.gameCount} ${w}.`} locale={lang} localized>
  <StudioDetail slug={slug} locale={lang} />
</Base>
