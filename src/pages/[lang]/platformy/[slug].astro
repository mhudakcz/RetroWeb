---
import Base from '../../../layouts/Base.astro';
import PlatformDetail from '../../../components/PlatformDetail.astro';
import { platforms, localeData } from '../../../lib/data';
import type { Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  const langs: Locale[] = ['en', 'de'];
  return langs.flatMap((lang) => platforms.map((p) => ({ params: { lang, slug: p.slug } })));
}
const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug!;
const platform = localeData(lang).getPlatform(slug)!;
---

<Base title={platform.name} description={`${platform.name} — ${platform.maker}, ${platform.year}.`} accent={platform.color} locale={lang} localized>
  <PlatformDetail slug={slug} locale={lang} />
</Base>
