---
import Base from '../../../layouts/Base.astro';
import PlatformsIndex from '../../../components/PlatformsIndex.astro';
import type { Locale } from '../../../lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'de' } }];
}
const locale = Astro.params.lang as Locale;
const DESC = {
  en: 'Overview of retro gaming platforms — consoles, handhelds, home computers, arcades and fantasy consoles.',
  de: 'Überblick über Retro-Gaming-Plattformen — Konsolen, Handhelds, Heimcomputer, Arcades und Fantasy-Konsolen.',
}[locale];
const TITLE = { en: 'Platforms', de: 'Plattformen' }[locale];
---

<Base title={TITLE} description={DESC} locale={locale} localized>
  <PlatformsIndex locale={locale} />
</Base>
