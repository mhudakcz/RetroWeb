---
import Base from '../../layouts/Base.astro';
import HardwareDetail from '../../components/HardwareDetail.astro';
import { hardware, getHardware } from '../../data/hardware';

export function getStaticPaths() {
  return hardware.map((h) => ({ params: { slug: h.slug } }));
}
const { slug } = Astro.params;
const hw = getHardware(slug!)!;
---

<Base title={hw.name} description={hw.tagline} accent={hw.color} locale="cs" localized>
  <HardwareDetail slug={slug!} locale="cs" />
</Base>
