---
import Base from '../../layouts/Base.astro';
import StudioDetail from '../../components/StudioDetail.astro';
import { studios, getStudio } from '../../lib/data';

export function getStaticPaths() {
  return studios.map((s) => ({ params: { slug: s.slug } }));
}
const { slug } = Astro.params;
const studio = getStudio(slug!)!;
---

<Base title={studio.name} description={`${studio.name} — historie, klíčové hry a osobnosti. ${studio.gameCount} her v katalogu RetroWeb.`} locale="cs" localized>
  <StudioDetail slug={slug!} locale="cs" />
</Base>
