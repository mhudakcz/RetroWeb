---
import Base from '../../layouts/Base.astro';
import PlatformDetail from '../../components/PlatformDetail.astro';
import { platforms, getPlatform } from '../../lib/data';

export function getStaticPaths() {
  return platforms.map((p) => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
const platform = getPlatform(slug!)!;
---

<Base
  title={platform.name}
  description={`${platform.name} (${platform.maker}, ${platform.year}) — historie platformy a ${platform.gameCount} doporučených her.`}
  accent={platform.color}
  locale="cs"
  localized
>
  <PlatformDetail slug={slug!} locale="cs" />
</Base>
